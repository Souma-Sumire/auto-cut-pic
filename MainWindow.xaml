<Window
    x:Class="AutoCutPic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AutoCutPic"
    xmlns:core="clr-namespace:AutoCutPic.Core"
    Title="AutoCutPic - 专业批量照片裁剪工作台"
    Width="1200"
    Height="820"
    MinWidth="960"
    MinHeight="640"
    Background="#1E1E1E"
    Foreground="#CCCCCC">
    <Window.Resources>
        <core:ZoomToWidthConverter x:Key="ZoomToWidthConverter" />
        <core:CropMarginConverter x:Key="CropMarginConverter" />
        <core:CropSizeConverter x:Key="CropSizeConverter" />
        <core:CropMaskConverter x:Key="CropMaskConverter" />
        <core:PsBoardSizeConverter x:Key="PsBoardSizeConverter" />
        <core:PsPaperSizeConverter x:Key="PsPaperSizeConverter" />
        <core:PsPaperMarginConverter x:Key="PsPaperMarginConverter" />
        <core:PsImgSizeConverter x:Key="PsImgSizeConverter" />
        <core:PsImgMarginConverter x:Key="PsImgMarginConverter" />
        <core:PsCropMaskConverter x:Key="PsCropMaskConverter" />
        <core:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <core:BatchCardPlacementConverter x:Key="BatchCardPlacementConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 工业风单选框样式 -->
        <Style x:Key="IndustrialRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,15,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="290" />
        </Grid.ColumnDefinitions>

        <!-- 全局流式导入进度指示器 -->
        <ProgressBar
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Height="3"
            VerticalAlignment="Top"
            Background="Transparent"
            Foreground="#0078D4"
            BorderThickness="0"
            Minimum="0"
            Maximum="100"
            Value="{Binding LoadingProgress}"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
            Panel.ZIndex="999" />

        <!--  左侧主工作台与底片胶卷  -->
        <!--  左侧主工作台与底片胶卷  -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部工作模式切换栏 -->
            <Border
                Grid.Row="0"
                Background="#1D1D1D"
                BorderBrush="#282828"
                BorderThickness="0,0,1,1"
                Padding="14,0">
                <Grid>
                    <!-- 模式切换分段按钮 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border
                            Background="#141414"
                            BorderBrush="#333333"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Command="{Binding SwitchViewModeCommand}"
                                    CommandParameter="Single"
                                    Padding="12,3"
                                    Cursor="Hand"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    BorderThickness="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="#888888" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentViewMode}" Value="Single">
                                                    <Setter Property="Background" Value="#333333" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="3" />
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="单张精调 (E)" />
                                </Button>

                                <Button
                                    Command="{Binding SwitchViewModeCommand}"
                                    CommandParameter="Batch"
                                    Margin="2,0,0,0"
                                    Padding="12,3"
                                    Cursor="Hand"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    BorderThickness="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="#888888" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentViewMode}" Value="Batch">
                                                    <Setter Property="Background" Value="#0078D4" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="3" />
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="批量画廊预览 (G)" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 右侧辅助信息 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Photos.Count, StringFormat='共 {0} 张照片'}" Foreground="#666666" FontSize="11" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  中央大图主视口（Photoshop 裁切画布工作台）  -->
            <Border
                x:Name="MainViewportHost"
                Grid.Row="1"
                Background="#181818"
                BorderBrush="#2D2D2D"
                BorderThickness="0,0,1,1"
                ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentViewMode}" Value="Batch">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <!-- 统一工作画板（纯白相纸底板、照片原图、遮罩与 PS 裁切框） -->
                    <Grid
                        x:Name="PhotoCanvas"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Cursor="SizeAll"
                        PreviewMouseDown="PhotoCanvas_MouseDown"
                        PreviewMouseMove="PhotoCanvas_MouseMove"
                        PreviewMouseUp="PhotoCanvas_MouseUp">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPhoto}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- 画板总尺寸动态绑定 -->
                        <Grid.Width>
                            <MultiBinding Converter="{StaticResource PsBoardSizeConverter}" ConverterParameter="Width">
                                <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                <Binding Path="SelectedPhoto.OriginalWidth" />
                                <Binding Path="SelectedPhoto.OriginalHeight" />
                                <Binding Path="SelectedSize" />
                                <Binding Path="SelectedMode" />
                            </MultiBinding>
                        </Grid.Width>
                        <Grid.Height>
                            <MultiBinding Converter="{StaticResource PsBoardSizeConverter}" ConverterParameter="Height">
                                <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                <Binding Path="SelectedPhoto.OriginalWidth" />
                                <Binding Path="SelectedPhoto.OriginalHeight" />
                                <Binding Path="SelectedSize" />
                                <Binding Path="SelectedMode" />
                            </MultiBinding>
                        </Grid.Height>

                        <!-- 层级 1：纯白相纸底板（在留白模式下显露真实的相纸纯白边，带立体物理阴影） -->
                        <Border
                            Background="#FFFFFF"
                            BorderBrush="#444444"
                            BorderThickness="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PsPaperSizeConverter}" ConverterParameter="Width">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Border.Width>
                            <Border.Height>
                                <MultiBinding Converter="{StaticResource PsPaperSizeConverter}" ConverterParameter="Height">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Border.Height>
                            <Border.Margin>
                                <MultiBinding Converter="{StaticResource PsPaperMarginConverter}">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Border.Margin>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="Black" Opacity="0.55" />
                            </Border.Effect>
                        </Border>

                        <!-- 层级 2：照片原图呈现（Fit 模式居中在纯白相纸上，Fill 模式铺满画板） -->
                        <Image
                            Source="{Binding HighResPreview}"
                            Stretch="Fill"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                            <Image.Width>
                                <MultiBinding Converter="{StaticResource PsImgSizeConverter}" ConverterParameter="Width">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Image.Width>
                            <Image.Height>
                                <MultiBinding Converter="{StaticResource PsImgSizeConverter}" ConverterParameter="Height">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Image.Height>
                            <Image.Margin>
                                <MultiBinding Converter="{StaticResource PsImgMarginConverter}">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Image.Margin>
                        </Image>

                        <!-- 层级 3：照片外围精细描边（确保浅色照片边缘与纯白相纸白边清晰可辨） -->
                        <Border
                            BorderBrush="#35000000"
                            BorderThickness="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PsImgSizeConverter}" ConverterParameter="Width">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Border.Width>
                            <Border.Height>
                                <MultiBinding Converter="{StaticResource PsImgSizeConverter}" ConverterParameter="Height">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Border.Height>
                            <Border.Margin>
                                <MultiBinding Converter="{StaticResource PsImgMarginConverter}">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Border.Margin>
                        </Border>

                        <!-- 层级 4：Fill 模式下相纸外部暗色遮罩（Fit 模式下为空，绝不遮挡纯白留白） -->
                        <Path Fill="#99000000" IsHitTestVisible="False">
                            <Path.Data>
                                <MultiBinding Converter="{StaticResource PsCropMaskConverter}">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Path.Data>
                        </Path>

                        <!-- 层级 5：Photoshop 裁切取景框（高反差边框 + 九宫格三分线 + 四角直角手柄） -->
                        <Grid
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False">
                            <Grid.Width>
                                <MultiBinding Converter="{StaticResource PsPaperSizeConverter}" ConverterParameter="Width">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Grid.Width>
                            <Grid.Height>
                                <MultiBinding Converter="{StaticResource PsPaperSizeConverter}" ConverterParameter="Height">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Grid.Height>
                            <Grid.Margin>
                                <MultiBinding Converter="{StaticResource PsPaperMarginConverter}">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Grid.Margin>

                            <!-- 外框双层高反差细实线（外黑内白，在任何深浅背景上都极度清晰） -->
                            <Border BorderBrush="#80000000" BorderThickness="2" Margin="-1" />
                            <Border BorderBrush="#F0FFFFFF" BorderThickness="1" />

                            <!-- 九宫格三等分线 (Rule of Thirds) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 纵向两条三等分线 -->
                                <Border Grid.Column="0" BorderBrush="#50FFFFFF" BorderThickness="0,0,1,0" />
                                <Border Grid.Column="1" BorderBrush="#50FFFFFF" BorderThickness="0,0,1,0" />

                                <!-- 横向两条三等分线 -->
                                <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="#50FFFFFF" BorderThickness="0,0,0,1" />
                                <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#50FFFFFF" BorderThickness="0,0,0,1" />
                            </Grid>

                            <!-- PS 风格四角直角折角控制手柄 -->
                            <Path Data="M 0,16 L 0,0 L 16,0" Stroke="White" StrokeThickness="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-1,-1,0,0" />
                            <Path Data="M 0,0 L 16,0 L 16,16" Stroke="White" StrokeThickness="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0" />
                            <Path Data="M 0,0 L 0,16 L 16,16" Stroke="White" StrokeThickness="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-1,0,0,-1" />
                            <Path Data="M 16,0 L 16,16 L 0,16" Stroke="White" StrokeThickness="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1" />

                            <!-- PS 风格四边中心横竖短线手柄 -->
                            <Rectangle Width="16" Height="3" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-1,0,0" />
                            <Rectangle Width="16" Height="3" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-1" />
                            <Rectangle Width="3" Height="16" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-1,0,0,0" />
                            <Rectangle Width="3" Height="16" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-1,0" />
                        </Grid>
                    </Grid>

                </Grid>
            </Border>

            <!-- 批量网格画廊预览 (ViewMode == Batch) -->
            <Border
                x:Name="BatchGalleryHost"
                Grid.Row="1"
                Background="#161616"
                BorderBrush="#2D2D2D"
                BorderThickness="0,0,1,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentViewMode}" Value="Batch">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <ListBox
                    x:Name="BatchGalleryList"
                    ItemsSource="{Binding Photos}"
                    SelectedItem="{Binding SelectedPhoto}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="16"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    MouseDoubleClick="BatchGalleryList_MouseDoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="6" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- 批量画廊单张卡片 -->
                            <Border
                                Width="190"
                                Height="165"
                                Background="#202020"
                                BorderThickness="1.5"
                                BorderBrush="#2F2F2F"
                                CornerRadius="4"
                                Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="BorderBrush" Value="#0078D4" />
                                                <Setter Property="Background" Value="#252A30" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="125" />
                                        <RowDefinition Height="38" />
                                    </Grid.RowDefinitions>

                                    <!-- 相纸视口展示区 (深暗色背景) -->
                                    <Border
                                        Grid.Row="0"
                                        Background="#121212"
                                        CornerRadius="3,3,0,0"
                                        ClipToBounds="True">
                                        <!-- 纯白冲印相纸 -->
                                        <Border
                                            Background="#FFFFFF"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ClipToBounds="True">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource BatchCardPlacementConverter}" ConverterParameter="PaperWidth">
                                                    <Binding Path="OriginalWidth" />
                                                    <Binding Path="OriginalHeight" />
                                                    <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    <Binding Path="DataContext.SelectedMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    <Binding Path="OffsetX" />
                                                    <Binding Path="OffsetY" />
                                                </MultiBinding>
                                            </Border.Width>
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource BatchCardPlacementConverter}" ConverterParameter="PaperHeight">
                                                    <Binding Path="OriginalWidth" />
                                                    <Binding Path="OriginalHeight" />
                                                    <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    <Binding Path="DataContext.SelectedMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    <Binding Path="OffsetX" />
                                                    <Binding Path="OffsetY" />
                                                </MultiBinding>
                                            </Border.Height>

                                            <!-- 裁切后照片渲染 -->
                                            <Image
                                                Source="{Binding Thumbnail}"
                                                Stretch="Fill"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                RenderOptions.BitmapScalingMode="LowQuality">
                                                <Image.Width>
                                                    <MultiBinding Converter="{StaticResource BatchCardPlacementConverter}" ConverterParameter="ImageWidth">
                                                        <Binding Path="OriginalWidth" />
                                                        <Binding Path="OriginalHeight" />
                                                        <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="DataContext.SelectedMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="OffsetX" />
                                                        <Binding Path="OffsetY" />
                                                    </MultiBinding>
                                                </Image.Width>
                                                <Image.Height>
                                                    <MultiBinding Converter="{StaticResource BatchCardPlacementConverter}" ConverterParameter="ImageHeight">
                                                        <Binding Path="OriginalWidth" />
                                                        <Binding Path="OriginalHeight" />
                                                        <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="DataContext.SelectedMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="OffsetX" />
                                                        <Binding Path="OffsetY" />
                                                    </MultiBinding>
                                                </Image.Height>
                                                <Image.Margin>
                                                    <MultiBinding Converter="{StaticResource BatchCardPlacementConverter}" ConverterParameter="ImageMargin">
                                                        <Binding Path="OriginalWidth" />
                                                        <Binding Path="OriginalHeight" />
                                                        <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="DataContext.SelectedMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="OffsetX" />
                                                        <Binding Path="OffsetY" />
                                                    </MultiBinding>
                                                </Image.Margin>
                                            </Image>
                                        </Border>
                                    </Border>

                                    <!-- 卡片底部元数据 -->
                                    <Grid Grid.Row="1" Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding FileName}"
                                            Foreground="#D0D0D0"
                                            FontSize="11"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding OriginalWidth, StringFormat='{}{0}w'}"
                                            Foreground="#666666"
                                            FontSize="10"
                                            VerticalAlignment="Center"
                                            Margin="4,0,0,0" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!--  底部胶卷缩略图条 (Filmstrip)  -->
            <Border
                Grid.Row="2"
                Height="130"
                Background="#141414"
                BorderBrush="#282828"
                BorderThickness="0,0,1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentViewMode}" Value="Batch">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <ListBox
                        x:Name="FilmstripList"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Photos}"
                        SelectedItem="{Binding SelectedPhoto}"
                        SelectionMode="Extended"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="4,8"
                                    Width="94"
                                    Height="106"
                                    Background="#1E1E1E"
                                    BorderThickness="2"
                                    BorderBrush="#333333">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#0078D4" />
                                                    <Setter Property="Background" Value="#252526" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="18" />
                                        </Grid.RowDefinitions>
                                        <Image
                                            Grid.Row="0"
                                            Source="{Binding Thumbnail}"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{Binding FileName}"
                                            FontSize="10"
                                            Foreground="#888888"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 胶卷左上角数量统计角标 -->
                    <Border
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="8,4,0,0"
                        Background="#CC000000"
                        Padding="6,2"
                        CornerRadius="2"
                        IsHitTestVisible="False">
                        <TextBlock
                            Text="{Binding Photos.Count, StringFormat='{}{0} 张'}"
                            FontSize="10"
                            Foreground="#888888" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  右侧属性设置面板  -->
        <Border
            Grid.Column="1"
            Background="#232323"
            BorderBrush="#2D2D2D"
            BorderThickness="0,0,0,0"
            Padding="18">
            <DockPanel LastChildFill="True">
                <!-- 底部批量导出按钮与状态信息 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
                    <!-- 导出与取消按钮容器 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Height="40"
                            Background="#0078D4"
                            Command="{Binding ExportCommand}"
                            Content="批量开始导出"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            FontSize="14"
                            Foreground="White"
                            BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4" />
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button
                            Grid.Column="1"
                            Height="40"
                            Margin="8,0,0,0"
                            Padding="14,0"
                            Background="#D83B01"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="13"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding CancelExportCommand}"
                            Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}"
                            Content="中止">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- 导出进度指示器 -->
                    <ProgressBar
                        Height="4"
                        Margin="0,8,0,0"
                        Background="#333333"
                        Foreground="#0078D4"
                        BorderThickness="0"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding ExportProgress}"
                        Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}" />

                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="#888888"
                        FontSize="11"
                        TextWrapping="Wrap"
                        Text="输出目录: 原图同级 Clipped_Photos" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="#CCCCCC"
                        FontSize="12"
                        FontWeight="Medium"
                        TextWrapping="Wrap"
                        Text="{Binding StatusText}" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#EEEEEE"
                                VerticalAlignment="Center"
                                Text="冲印设置" />
                            <Button
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="#333333"
                                Foreground="#CCCCCC"
                                BorderThickness="0"
                                Padding="8,4"
                                Cursor="Hand"
                                FontSize="11"
                                Click="SelectFolder_Click"
                                Content="+ 导入">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="3" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- 当前照片信息卡片 -->
                        <Border
                            Background="#1E1E1E"
                            BorderBrush="#303030"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPhoto}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#AAAAAA"
                                    Text="当前照片" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Text="{Binding SelectedPhoto.FileName}"
                                    Foreground="#FFFFFF"
                                    FontWeight="Medium"
                                    FontSize="12"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding SelectedPhoto.FilePath}" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock Text="原图像素: " FontSize="11" Foreground="#666666" />
                                    <TextBlock Text="{Binding SelectedPhoto.OriginalWidth}" FontSize="11" Foreground="#AAAAAA" />
                                    <TextBlock Text=" x " FontSize="11" Foreground="#666666" />
                                    <TextBlock Text="{Binding SelectedPhoto.OriginalHeight}" FontSize="11" Foreground="#AAAAAA" />
                                    <TextBlock Text=" px" FontSize="11" Foreground="#666666" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border
                            Background="#1E1E1E"
                            BorderBrush="#303030"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#AAAAAA"
                                    Text="相纸规格 (300 DPI)" />
                                <ComboBox
                                    Margin="0,8,0,8"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding Sizes}"
                                    SelectedItem="{Binding SelectedSize}"
                                    Height="28" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="输出像素: " FontSize="11" Foreground="#666666" />
                                    <TextBlock Text="{Binding SelectedSize.PixelWidth}" FontSize="11" Foreground="#888888" />
                                    <TextBlock Text="x" FontSize="11" Foreground="#666666" />
                                    <TextBlock Text="{Binding SelectedSize.PixelHeight}" FontSize="11" Foreground="#888888" />
                                    <TextBlock Text=" px" FontSize="11" Foreground="#666666" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border
                            Background="#1E1E1E"
                            BorderBrush="#303030"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#AAAAAA"
                                    Text="裁切排版" />
                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <RadioButton
                                        Style="{StaticResource IndustrialRadio}"
                                        Content="裁剪填充 (Fill)"
                                        IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fill}" />
                                    <RadioButton
                                        Style="{StaticResource IndustrialRadio}"
                                        Content="留白完整 (Fit)"
                                        IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fit}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border
                            Background="#1A1A1A"
                            BorderBrush="#2C2C2C"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#888888"
                                    Text="操作快捷键" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="20" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="G / 双击卡片" Foreground="#0078D4" FontSize="11" FontWeight="Medium" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="切换批量网格 / 单张精调" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="鼠标左键拖拽" Foreground="#CCCCCC" FontSize="11" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="平移裁切框与构图" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="WASD / 方向键" Foreground="#CCCCCC" FontSize="11" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="1% 像素级步进微调" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Shift + WASD" Foreground="#CCCCCC" FontSize="11" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="10% 快速大幅移动" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl + WASD" Foreground="#CCCCCC" FontSize="11" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="瞬间对齐边沿贴边" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Space (空格键)" Foreground="#CCCCCC" FontSize="11" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="切换填充 / 留白模式" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Enter (回车键)" Foreground="#CCCCCC" FontSize="11" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="直接开始批量导出" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!--  全屏导入引导层 (当未导入照片时占满整个视口)  -->
        <Grid
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="#181818">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Photos.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid
                MaxWidth="880"
                MaxHeight="560"
                Margin="32">
                <Rectangle
                    Stroke="#2E2E2E"
                    StrokeThickness="1.5"
                    StrokeDashArray="6 6"
                    RadiusX="8"
                    RadiusY="8"
                    IsHitTestVisible="False" />

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border
                            Width="88"
                            Height="88"
                            Margin="0,0,0,24"
                            Background="#252526"
                            BorderBrush="#383838"
                            BorderThickness="1"
                            CornerRadius="44"
                            HorizontalAlignment="Center">
                            <Path
                                Width="32"
                                Height="32"
                                Data="M 0,16 L 32,16 M 16,0 L 16,32"
                                Stroke="#0078D4"
                                StrokeThickness="3"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <TextBlock
                            Text="拖拽照片或文件夹至此"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,28" />

                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,24">
                            <Button
                                Width="160"
                                Height="42"
                                Margin="0,0,16,0"
                                Background="#0078D4"
                                Foreground="#FFFFFF"
                                FontSize="14"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SelectFolder_Click"
                                Content="导入照片文件夹">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button
                                Width="160"
                                Height="42"
                                Background="#2A2A2A"
                                Foreground="#CCCCCC"
                                FontSize="14"
                                FontWeight="SemiBold"
                                BorderBrush="#444444"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="SelectFiles_Click"
                                Content="添加照片文件">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                            <Border Background="#252526" BorderBrush="#353535" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="4,0">
                                <TextBlock Text="JPG / JPEG" FontSize="11" Foreground="#AAAAAA" />
                            </Border>
                            <Border Background="#252526" BorderBrush="#353535" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="4,0">
                                <TextBlock Text="PNG" FontSize="11" Foreground="#AAAAAA" />
                            </Border>
                            <Border Background="#252526" BorderBrush="#353535" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="4,0">
                                <TextBlock Text="HEIC" FontSize="11" Foreground="#AAAAAA" />
                            </Border>
                            <Border Background="#252526" BorderBrush="#353535" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="4,0">
                                <TextBlock Text="ZIP (Live Photo)" FontSize="11" Foreground="#AAAAAA" />
                            </Border>
                            <Border Background="#252526" BorderBrush="#353535" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="4,0">
                                <TextBlock Text="WEBP" FontSize="11" Foreground="#AAAAAA" />
                            </Border>
                            <Border Background="#252526" BorderBrush="#353535" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="4,0">
                                <TextBlock Text="TIFF / BMP" FontSize="11" Foreground="#AAAAAA" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock
                            Text="正在载入照片"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20" />

                        <ProgressBar
                            Width="360"
                            Height="6"
                            Background="#252526"
                            Foreground="#0078D4"
                            BorderThickness="0"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding LoadingProgress}" />

                        <TextBlock
                            Margin="0,16,0,0"
                            Text="{Binding LoadingStatusText}"
                            FontSize="12"
                            Foreground="#888888"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
        </Grid>
    </Grid>
</Window>
