<Window
    x:Class="AutoCutPic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AutoCutPic"
    xmlns:core="clr-namespace:AutoCutPic.Core"
    Title="AutoCutPic - 专业批量照片裁剪工作台"
    Width="1200"
    Height="820"
    MinWidth="960"
    MinHeight="640"
    Background="#1E1E1E"
    Foreground="#CCCCCC">
    <Window.Resources>
        <core:ZoomToWidthConverter x:Key="ZoomToWidthConverter" />
        <core:CropMarginConverter x:Key="CropMarginConverter" />
        <core:CropSizeConverter x:Key="CropSizeConverter" />
        <core:CropMaskConverter x:Key="CropMaskConverter" />
        <core:PsBoardSizeConverter x:Key="PsBoardSizeConverter" />
        <core:PsPaperSizeConverter x:Key="PsPaperSizeConverter" />
        <core:PsPaperMarginConverter x:Key="PsPaperMarginConverter" />
        <core:PsImgSizeConverter x:Key="PsImgSizeConverter" />
        <core:PsImgMarginConverter x:Key="PsImgMarginConverter" />
        <core:PsCropMaskConverter x:Key="PsCropMaskConverter" />
        <core:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 工业风单选框样式 -->
        <Style x:Key="IndustrialRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,15,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="290" />
        </Grid.ColumnDefinitions>

        <!--  左侧主工作台与底片胶卷  -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  中央大图主视口（Photoshop 裁切画布工作台）  -->
            <Border
                x:Name="MainViewportHost"
                Grid.Row="0"
                Background="#181818"
                BorderBrush="#2D2D2D"
                BorderThickness="0,0,1,1"
                ClipToBounds="True">
                <Grid>
                    <!-- 统一工作画板（纯白相纸底板、照片原图、遮罩与 PS 裁切框） -->
                    <Grid
                        x:Name="PhotoCanvas"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Cursor="SizeAll"
                        PreviewMouseDown="PhotoCanvas_MouseDown"
                        PreviewMouseMove="PhotoCanvas_MouseMove"
                        PreviewMouseUp="PhotoCanvas_MouseUp">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPhoto}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- 画板总尺寸动态绑定 -->
                        <Grid.Width>
                            <MultiBinding Converter="{StaticResource PsBoardSizeConverter}" ConverterParameter="Width">
                                <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                <Binding Path="SelectedPhoto.OriginalWidth" />
                                <Binding Path="SelectedPhoto.OriginalHeight" />
                                <Binding Path="SelectedSize" />
                                <Binding Path="SelectedMode" />
                            </MultiBinding>
                        </Grid.Width>
                        <Grid.Height>
                            <MultiBinding Converter="{StaticResource PsBoardSizeConverter}" ConverterParameter="Height">
                                <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                <Binding Path="SelectedPhoto.OriginalWidth" />
                                <Binding Path="SelectedPhoto.OriginalHeight" />
                                <Binding Path="SelectedSize" />
                                <Binding Path="SelectedMode" />
                            </MultiBinding>
                        </Grid.Height>

                        <!-- 层级 1：纯白相纸底板（在留白模式下显露真实的相纸纯白边，带立体物理阴影） -->
                        <Border
                            Background="#FFFFFF"
                            BorderBrush="#444444"
                            BorderThickness="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PsPaperSizeConverter}" ConverterParameter="Width">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Border.Width>
                            <Border.Height>
                                <MultiBinding Converter="{StaticResource PsPaperSizeConverter}" ConverterParameter="Height">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Border.Height>
                            <Border.Margin>
                                <MultiBinding Converter="{StaticResource PsPaperMarginConverter}">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Border.Margin>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="Black" Opacity="0.55" />
                            </Border.Effect>
                        </Border>

                        <!-- 层级 2：照片原图呈现（Fit 模式居中在纯白相纸上，Fill 模式铺满画板） -->
                        <Image
                            Source="{Binding HighResPreview}"
                            Stretch="Fill"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                            <Image.Width>
                                <MultiBinding Converter="{StaticResource PsImgSizeConverter}" ConverterParameter="Width">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Image.Width>
                            <Image.Height>
                                <MultiBinding Converter="{StaticResource PsImgSizeConverter}" ConverterParameter="Height">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Image.Height>
                            <Image.Margin>
                                <MultiBinding Converter="{StaticResource PsImgMarginConverter}">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Image.Margin>
                        </Image>

                        <!-- 层级 3：照片外围精细描边（确保浅色照片边缘与纯白相纸白边清晰可辨） -->
                        <Border
                            BorderBrush="#35000000"
                            BorderThickness="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PsImgSizeConverter}" ConverterParameter="Width">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Border.Width>
                            <Border.Height>
                                <MultiBinding Converter="{StaticResource PsImgSizeConverter}" ConverterParameter="Height">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Border.Height>
                            <Border.Margin>
                                <MultiBinding Converter="{StaticResource PsImgMarginConverter}">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Border.Margin>
                        </Border>

                        <!-- 层级 4：Fill 模式下相纸外部暗色遮罩（Fit 模式下为空，绝不遮挡纯白留白） -->
                        <Path Fill="#99000000" IsHitTestVisible="False">
                            <Path.Data>
                                <MultiBinding Converter="{StaticResource PsCropMaskConverter}">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Path.Data>
                        </Path>

                        <!-- 层级 5：Photoshop 裁切取景框（高反差边框 + 九宫格三分线 + 四角直角手柄） -->
                        <Grid
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False">
                            <Grid.Width>
                                <MultiBinding Converter="{StaticResource PsPaperSizeConverter}" ConverterParameter="Width">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Grid.Width>
                            <Grid.Height>
                                <MultiBinding Converter="{StaticResource PsPaperSizeConverter}" ConverterParameter="Height">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Grid.Height>
                            <Grid.Margin>
                                <MultiBinding Converter="{StaticResource PsPaperMarginConverter}">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                </MultiBinding>
                            </Grid.Margin>

                            <!-- 外框双层高反差细实线（外黑内白，在任何深浅背景上都极度清晰） -->
                            <Border BorderBrush="#80000000" BorderThickness="2" Margin="-1" />
                            <Border BorderBrush="#F0FFFFFF" BorderThickness="1" />

                            <!-- 九宫格三等分线 (Rule of Thirds) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 纵向两条三等分线 -->
                                <Border Grid.Column="0" BorderBrush="#50FFFFFF" BorderThickness="0,0,1,0" />
                                <Border Grid.Column="1" BorderBrush="#50FFFFFF" BorderThickness="0,0,1,0" />

                                <!-- 横向两条三等分线 -->
                                <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="#50FFFFFF" BorderThickness="0,0,0,1" />
                                <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#50FFFFFF" BorderThickness="0,0,0,1" />
                            </Grid>

                            <!-- PS 风格四角直角折角控制手柄 -->
                            <Path Data="M 0,16 L 0,0 L 16,0" Stroke="White" StrokeThickness="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-1,-1,0,0" />
                            <Path Data="M 0,0 L 16,0 L 16,16" Stroke="White" StrokeThickness="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0" />
                            <Path Data="M 0,0 L 0,16 L 16,16" Stroke="White" StrokeThickness="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-1,0,0,-1" />
                            <Path Data="M 16,0 L 16,16 L 0,16" Stroke="White" StrokeThickness="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1" />

                            <!-- PS 风格四边中心横竖短线手柄 -->
                            <Rectangle Width="16" Height="3" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-1,0,0" />
                            <Rectangle Width="16" Height="3" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-1" />
                            <Rectangle Width="3" Height="16" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-1,0,0,0" />
                            <Rectangle Width="3" Height="16" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-1,0" />
                        </Grid>
                    </Grid>

                    <!-- 视口底部半透明浮动状态指示栏 -->
                    <Border
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,12"
                        Background="#CC202020"
                        BorderBrush="#383838"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,6"
                        IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPhoto}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedPhoto.FileName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="  |  " Foreground="#555555" FontSize="12" />
                            <TextBlock Text="原图: " Foreground="#888888" FontSize="12" />
                            <TextBlock Text="{Binding SelectedPhoto.OriginalWidth}" Foreground="#AAAAAA" FontSize="12" />
                            <TextBlock Text="x" Foreground="#888888" FontSize="12" />
                            <TextBlock Text="{Binding SelectedPhoto.OriginalHeight}" Foreground="#AAAAAA" FontSize="12" />
                            <TextBlock Text=" px" Foreground="#888888" FontSize="12" />
                            <TextBlock Text="  |  " Foreground="#555555" FontSize="12" />
                            <TextBlock Text="拖拽或 WASD 平移构图" Foreground="#0078D4" FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!--  底部胶卷缩略图条 (Filmstrip)  -->
            <Border
                Grid.Row="1"
                Height="130"
                Background="#141414"
                BorderBrush="#282828"
                BorderThickness="0,0,1,0">
                <Grid>
                    <ListBox
                        x:Name="FilmstripList"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Photos}"
                        SelectedItem="{Binding SelectedPhoto}"
                        SelectionMode="Extended"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="4,8"
                                    Width="94"
                                    Height="106"
                                    Background="#1E1E1E"
                                    BorderThickness="2"
                                    BorderBrush="#333333">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#0078D4" />
                                                    <Setter Property="Background" Value="#252526" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="18" />
                                        </Grid.RowDefinitions>
                                        <Image
                                            Grid.Row="0"
                                            Source="{Binding Thumbnail}"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{Binding FileName}"
                                            FontSize="10"
                                            Foreground="#888888"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 胶卷左上角数量统计角标 -->
                    <Border
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="8,4,0,0"
                        Background="#CC000000"
                        Padding="6,2"
                        CornerRadius="2"
                        IsHitTestVisible="False">
                        <TextBlock
                            Text="{Binding Photos.Count, StringFormat='共 {0} 张照片'}"
                            FontSize="10"
                            Foreground="#888888" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  右侧 Photoshop 属性设置面板  -->
        <Border
            Grid.Column="1"
            Background="#232323"
            BorderBrush="#2D2D2D"
            BorderThickness="0,0,0,0"
            Padding="18">
            <DockPanel LastChildFill="True">
                <!-- 底部批量导出按钮与状态信息 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
                    <Button
                        Height="40"
                        Background="#0078D4"
                        Command="{Binding ExportCommand}"
                        Content="批量开始导出"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        FontSize="14"
                        Foreground="White"
                        BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="#888888"
                        FontSize="11"
                        TextWrapping="Wrap"
                        Text="导出位置: 原图目录下的 Clipped_Photos" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="#AAAAAA"
                        FontSize="12"
                        FontWeight="Medium"
                        Text="{Binding StatusText}" />
                </StackPanel>

                <!-- 上部属性控制 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 标题栏与快速添加按钮 -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#EEEEEE"
                                VerticalAlignment="Center"
                                Text="冲印属性面板" />
                            <Button
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="#333333"
                                Foreground="#CCCCCC"
                                BorderThickness="0"
                                Padding="8,4"
                                Cursor="Hand"
                                FontSize="11"
                                Click="SelectFolder_Click"
                                Content="+ 导入">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="3" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- 模块 1：输出规格 -->
                        <Border
                            Background="#1E1E1E"
                            BorderBrush="#303030"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#AAAAAA"
                                    Text="目标相纸规格 (300 DPI)" />
                                <ComboBox
                                    Margin="0,8,0,8"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding Sizes}"
                                    SelectedItem="{Binding SelectedSize}"
                                    Height="28" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="实际输出: " FontSize="11" Foreground="#666666" />
                                    <TextBlock Text="{Binding SelectedSize.PixelWidth}" FontSize="11" Foreground="#888888" />
                                    <TextBlock Text="x" FontSize="11" Foreground="#666666" />
                                    <TextBlock Text="{Binding SelectedSize.PixelHeight}" FontSize="11" Foreground="#888888" />
                                    <TextBlock Text=" px (横竖自适应)" FontSize="11" Foreground="#666666" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 模块 2：裁切模式 -->
                        <Border
                            Background="#1E1E1E"
                            BorderBrush="#303030"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#AAAAAA"
                                    Text="裁切与排版模式" />
                                <StackPanel Margin="0,10,0,4" Orientation="Horizontal">
                                    <RadioButton
                                        Style="{StaticResource IndustrialRadio}"
                                        Content="裁剪填充 (Fill)"
                                        IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fill}" />
                                    <RadioButton
                                        Style="{StaticResource IndustrialRadio}"
                                        Content="留白完整 (Fit)"
                                        IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fit}" />
                                </StackPanel>
                                <TextBlock
                                    Text="Fill 填满相纸且无白边；Fit 呈现相纸纯白留白边框。"
                                    FontSize="11"
                                    Foreground="#666666"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 模块 3：快捷键工作流指南 -->
                        <Border
                            Background="#1A1A1A"
                            BorderBrush="#2C2C2C"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#888888"
                                    Text="快捷键与操作手势" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="20" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="鼠标左键拖拽" Foreground="#0078D4" FontSize="11" FontWeight="Medium" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="平移裁切框与构图" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="WASD / 方向键" Foreground="#CCCCCC" FontSize="11" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="1% 像素级步进微调" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Shift + WASD" Foreground="#CCCCCC" FontSize="11" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="10% 快速大幅移动" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl + WASD" Foreground="#CCCCCC" FontSize="11" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="瞬间对齐边沿贴边" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Space (空格键)" Foreground="#CCCCCC" FontSize="11" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="切换填充 / 留白模式" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Enter (回车键)" Foreground="#CCCCCC" FontSize="11" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="直接开始批量导出" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!--  全屏导入引导层 (当未导入照片时占满整个视口)  -->
        <Grid
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="#181818">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Photos.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- 居中全屏大面积投递卡片 -->
            <Border
                MaxWidth="880"
                MaxHeight="580"
                Margin="48"
                Background="#1E1E1E"
                BorderBrush="#333333"
                BorderThickness="2"
                CornerRadius="12"
                Padding="40">
                <Grid>
                    <!-- 虚线轮廓装饰 -->
                    <Rectangle
                        Stroke="#3E3E3E"
                        StrokeThickness="1.5"
                        StrokeDashArray="6 4"
                        RadiusX="10"
                        RadiusY="10"
                        IsHitTestVisible="False" />

                    <!-- 引导主体内容 -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <!-- 大号图标 -->
                        <Border
                            Width="88"
                            Height="88"
                            Margin="0,0,0,24"
                            Background="#252526"
                            BorderBrush="#383838"
                            BorderThickness="1"
                            CornerRadius="44"
                            HorizontalAlignment="Center">
                            <Path
                                Data="M 28,44 L 60,44 M 44,28 L 44,60"
                                Stroke="#0078D4"
                                StrokeThickness="3.5"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <!-- 主标题 -->
                        <TextBlock
                            Text="拖拽照片或文件夹至此开始"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            HorizontalAlignment="Center" />

                        <!-- 副标题说明 -->
                        <TextBlock
                            Margin="0,10,0,28"
                            Text="自动深度递归扫描所有子目录，原生兼容 iOS HEIC、Live Photo 压缩包及全画幅相机原图"
                            FontSize="13"
                            Foreground="#888888"
                            HorizontalAlignment="Center" />

                        <!-- 快捷操作按钮组 -->
                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,32">
                            <Button
                                Width="160"
                                Height="42"
                                Margin="0,0,16,0"
                                Background="#0078D4"
                                Foreground="#FFFFFF"
                                FontSize="14"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SelectFolder_Click"
                                Content="导入照片文件夹">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button
                                Width="160"
                                Height="42"
                                Background="#2A2A2A"
                                Foreground="#CCCCCC"
                                FontSize="14"
                                FontWeight="SemiBold"
                                BorderBrush="#444444"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="SelectFiles_Click"
                                Content="添加照片文件">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- 支持格式徽标平铺列表 -->
                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                            <Border Background="#252526" BorderBrush="#353535" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="4,0">
                                <TextBlock Text="JPG / JPEG" FontSize="11" Foreground="#AAAAAA" />
                            </Border>
                            <Border Background="#252526" BorderBrush="#353535" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="4,0">
                                <TextBlock Text="PNG" FontSize="11" Foreground="#AAAAAA" />
                            </Border>
                            <Border Background="#252526" BorderBrush="#353535" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="4,0">
                                <TextBlock Text="HEIC (Apple)" FontSize="11" Foreground="#AAAAAA" />
                            </Border>
                            <Border Background="#252526" BorderBrush="#353535" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="4,0">
                                <TextBlock Text="ZIP (Live Photo)" FontSize="11" Foreground="#AAAAAA" />
                            </Border>
                            <Border Background="#252526" BorderBrush="#353535" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="4,0">
                                <TextBlock Text="WEBP" FontSize="11" Foreground="#AAAAAA" />
                            </Border>
                            <Border Background="#252526" BorderBrush="#353535" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="4,0">
                                <TextBlock Text="TIFF / BMP" FontSize="11" Foreground="#AAAAAA" />
                            </Border>
                        </StackPanel>

                        <!-- 底部冲印技术标准小字 -->
                        <TextBlock
                            Text="工业级 300 DPI 严格像素转换  •  基于 Parallel.ForEach 多核极速并发导出"
                            FontSize="11"
                            Foreground="#555555"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
