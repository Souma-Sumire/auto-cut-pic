<Window
    x:Class="AutoCutPic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AutoCutPic"
    xmlns:core="clr-namespace:AutoCutPic.Core"
    Title="AutoCutPic - 高性能批量照片裁剪"
    Width="1000"
    Height="700"
    Background="#F5F5F7">
    <Window.Resources>
        <core:ZoomToWidthConverter x:Key="ZoomToWidthConverter" />
        <core:CropMarginConverter x:Key="CropMarginConverter" />
        <core:CropSizeConverter x:Key="CropSizeConverter" />
        <core:CropMaskConverter x:Key="CropMaskConverter" />
        <core:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="30" />
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4" />
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!--  左侧画廊区  -->
        <Border
            Grid.Column="0"
            Margin="20"
            Background="#E0E0E0"
            BorderBrush="#E5E5E5"
            BorderThickness="1"
            CornerRadius="12">
            <Grid>
                <ListBox
                    x:Name="PhotoGallery"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Photos}"
                    SelectedItem="{Binding SelectedPhoto}"
                    SelectionMode="Extended"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="10" Background="White" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="BorderBrush" Value="#007AFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid x:Name="ThumbnailContainer"
                                      Width="{Binding DataContext.ZoomFactor, ElementName=PhotoGallery, Converter={StaticResource ZoomToWidthConverter}}"
                                      Height="{Binding DataContext.ZoomFactor, ElementName=PhotoGallery, Converter={StaticResource ZoomToWidthConverter}}"
                                      Background="#222222"
                                      ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                    <!-- 裁切与遮罩叠加层 -->
                                    <Canvas IsHitTestVisible="False">
                                        <!-- 被裁切部分半透明暗色遮罩 -->
                                        <Path Fill="#77000000">
                                            <Path.Data>
                                                <MultiBinding Converter="{StaticResource CropMaskConverter}">
                                                    <Binding Path="ActualWidth" ElementName="ThumbnailContainer" />
                                                    <Binding Path="OriginalWidth" />
                                                    <Binding Path="OriginalHeight" />
                                                    <Binding Path="OffsetX" />
                                                    <Binding Path="OffsetY" />
                                                    <Binding Path="DataContext.SelectedSize" ElementName="PhotoGallery" />
                                                    <Binding Path="DataContext.SelectedMode" ElementName="PhotoGallery" />
                                                </MultiBinding>
                                            </Path.Data>
                                        </Path>
                                        <!-- 裁切框边线与轻微高亮 -->
                                        <Rectangle Stroke="#007AFF" StrokeThickness="2" Fill="#12007AFF">
                                            <Rectangle.Width>
                                                <MultiBinding Converter="{StaticResource CropSizeConverter}" ConverterParameter="Width">
                                                    <Binding Path="ActualWidth" ElementName="ThumbnailContainer" />
                                                    <Binding Path="OriginalWidth" />
                                                    <Binding Path="OriginalHeight" />
                                                    <Binding Path="OffsetX" />
                                                    <Binding Path="OffsetY" />
                                                    <Binding Path="DataContext.SelectedSize" ElementName="PhotoGallery" />
                                                    <Binding Path="DataContext.SelectedMode" ElementName="PhotoGallery" />
                                                </MultiBinding>
                                            </Rectangle.Width>
                                            <Rectangle.Height>
                                                <MultiBinding Converter="{StaticResource CropSizeConverter}" ConverterParameter="Height">
                                                    <Binding Path="ActualWidth" ElementName="ThumbnailContainer" />
                                                    <Binding Path="OriginalWidth" />
                                                    <Binding Path="OriginalHeight" />
                                                    <Binding Path="OffsetX" />
                                                    <Binding Path="OffsetY" />
                                                    <Binding Path="DataContext.SelectedSize" ElementName="PhotoGallery" />
                                                    <Binding Path="DataContext.SelectedMode" ElementName="PhotoGallery" />
                                                </MultiBinding>
                                            </Rectangle.Height>
                                            <Rectangle.Margin>
                                                <MultiBinding Converter="{StaticResource CropMarginConverter}">
                                                    <Binding Path="ActualWidth" ElementName="ThumbnailContainer" />
                                                    <Binding Path="OriginalWidth" />
                                                    <Binding Path="OriginalHeight" />
                                                    <Binding Path="OffsetX" />
                                                    <Binding Path="OffsetY" />
                                                    <Binding Path="DataContext.SelectedSize" ElementName="PhotoGallery" />
                                                    <Binding Path="DataContext.SelectedMode" ElementName="PhotoGallery" />
                                                </MultiBinding>
                                            </Rectangle.Margin>
                                        </Rectangle>
                                    </Canvas>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,15" Background="#88FFFFFF">
                   <TextBlock Text="预览缩放: " VerticalAlignment="Center" Margin="5"/>
                   <Slider Width="150" Minimum="0.5" Maximum="3.0" Value="{Binding ZoomFactor}" />
                </StackPanel>

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Foreground="#999"
                    Text="拖拽文件夹至此开始"
                    IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Photos.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!--  右侧设置区  -->
        <StackPanel Grid.Column="1" Margin="20">
            <TextBlock
                Margin="0,0,0,20"
                FontSize="20"
                FontWeight="Bold"
                Foreground="#333"
                Text="裁剪设置" />

            <TextBlock
                Margin="0,10,0,5"
                Foreground="#666"
                Text="输出尺寸" />
            <ComboBox
                Margin="0,0,0,15"
                DisplayMemberPath="Name"
                ItemsSource="{Binding Sizes}"
                SelectedItem="{Binding SelectedSize}" />

            <TextBlock
                Margin="0,10,0,5"
                Foreground="#666"
                Text="裁剪方式" />
            <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                <RadioButton
                    Margin="0,0,20,0"
                    Content="裁剪填充"
                    IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fill}" />
                <RadioButton 
                    Content="留白完整" 
                    IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fit}" />
            </StackPanel>

            <Separator Margin="0,10,0,20" />

            <Button
                Height="45"
                Background="#007AFF"
                Command="{Binding ExportCommand}"
                Content="批量开始导出"
                Cursor="Hand"
                FontWeight="Bold"
                Foreground="White"
                BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <!--  底部状态栏  -->
        <StatusBar
            Grid.ColumnSpan="2"
            Margin="20,0,20,10"
            VerticalAlignment="Bottom"
            Background="Transparent">
            <StatusBarItem>
                <TextBlock Foreground="#888" Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
