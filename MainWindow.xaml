<Window
    x:Class="AutoCutPic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AutoCutPic"
    xmlns:core="clr-namespace:AutoCutPic.Core"
    Title="AutoCutPic - 专业批量照片裁剪工作台"
    Width="1280"
    Height="860"
    MinWidth="680"
    MinHeight="520"
    Background="#1E1E1E"
    Foreground="#CCCCCC"
    InputMethod.IsInputMethodEnabled="False">
    <Window.Resources>
        <core:ZoomToWidthConverter x:Key="ZoomToWidthConverter" />
        <core:CropMarginConverter x:Key="CropMarginConverter" />
        <core:CropSizeConverter x:Key="CropSizeConverter" />
        <core:CropMaskConverter x:Key="CropMaskConverter" />
        <core:PsBoardSizeConverter x:Key="PsBoardSizeConverter" />
        <core:PsPaperSizeConverter x:Key="PsPaperSizeConverter" />
        <core:PsPaperMarginConverter x:Key="PsPaperMarginConverter" />
        <core:PsImgSizeConverter x:Key="PsImgSizeConverter" />
        <core:PsImgMarginConverter x:Key="PsImgMarginConverter" />
        <core:PsCropMaskConverter x:Key="PsCropMaskConverter" />
        <core:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <core:BatchCardCropConverter x:Key="BatchCardCropConverter" />
        <core:CutModeToDisplayConverter x:Key="CutModeToDisplayConverter" />
        <core:OrientationToDisplayConverter x:Key="OrientationToDisplayConverter" />
        <core:DimMatchedOpacityConverter x:Key="DimMatchedOpacityConverter" />
        <core:HideMatchedVisibilityConverter x:Key="HideMatchedVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ═══════════════════════════════════════════════════════════════
             基础视觉语言：工业风暗色主题
             ═══════════════════════════════════════════════════════════════ -->

        <!-- 工业风专业暗色上下文菜单与菜单项统一样式 -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="BorderBrush" Value="#3E3E42" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#D4D4D4" />
            <Setter Property="Padding" Value="2,4" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.45" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Separator}">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="Background" Value="#383838" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="{TemplateBinding Height}" Margin="{TemplateBinding Margin}" Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="#D4D4D4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border
                            x:Name="BgBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            Padding="6,0,10,0"
                            Margin="2,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" SharedSizeGroup="MenuItemIconColumn" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumn" />
                                </Grid.ColumnDefinitions>

                                <Path
                                    x:Name="CheckMark"
                                    Grid.Column="0"
                                    Data="M 2 6 L 6 10 L 13 3"
                                    Stroke="#0078D4"
                                    StrokeThickness="1.5"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" />

                                <ContentPresenter
                                    x:Name="HeaderHost"
                                    Grid.Column="1"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True"
                                    VerticalAlignment="Center"
                                    Margin="4,0,12,0" />

                                <TextBlock
                                    x:Name="GestureText"
                                    Grid.Column="2"
                                    Text="{TemplateBinding InputGestureText}"
                                    Foreground="#888888"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="12,0,2,0"
                                    Visibility="Visible" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#33373B" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="CheckMark" Property="Stroke" Value="#38A9FF" />
                                <Setter TargetName="GestureText" Property="Foreground" Value="#BBBBBB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#555555" />
                                <Setter TargetName="GestureText" Property="Foreground" Value="#444444" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 暗黑精致滚动条样式：精细紧凑，杜绝遮挡内容与粗大箭头挤占空间 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="8" />
                    <Setter Property="MinHeight" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#444444" CornerRadius="4" Height="6" VerticalAlignment="Center" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8" />
                    <Setter Property="MinWidth" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#444444" CornerRadius="4" Width="6" HorizontalAlignment="Center" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             响应式控件样式：所有横向分组均为流式布局，窄窗口下自动换行而非重叠
             ═══════════════════════════════════════════════════════════════ -->

        <!-- 工具栏分组标签 -->
        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6E6E6E" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,8,3" />
        </Style>

        <!-- 工具栏竖分隔线 -->
        <Style x:Key="VerticalRule" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Margin" Value="4,3,14,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 次级动作按钮 -->
        <Style x:Key="ToolbarActionButton" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,3,6,3" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#2B2B2B" />
            <Setter Property="Foreground" Value="#D4D4D4" />
            <Setter Property="BorderBrush" Value="#3E3E42" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A" />
                                <Setter Property="BorderBrush" Value="#4E4E52" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C1C1C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5A5A5A" />
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主行动按钮（导入 / 导出） -->
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ToolbarActionButton}">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#0A84E0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A88DD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0069BB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险动作按钮（中止导出） -->
        <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource ToolbarActionButton}">
            <Setter Property="Background" Value="#D83B01" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E24A10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E85018" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B93100" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 导出主按钮 / 中止按钮（面板底部大号按钮） -->
        <Style x:Key="ExportActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="AbortActionButton" TargetType="Button" BasedOn="{StaticResource DangerActionButton}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- 视图模式分段切换项 -->
        <Style x:Key="SegmentedToggleItem" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333" />
                                <Setter Property="Foreground" Value="#DDDDDD" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0078D4" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5A5A5A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 紧凑单选（免修过滤 / 裁切排版），窄容器内自动换行 -->
        <Style x:Key="CompactRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B8B8B8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,12,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border
                                x:Name="Dot"
                                Width="12"
                                Height="12"
                                Background="#1E1E1E"
                                BorderBrush="#5A5A5A"
                                BorderThickness="1"
                                CornerRadius="6"
                                VerticalAlignment="Center">
                                <Ellipse
                                    x:Name="Mark"
                                    Width="5"
                                    Height="5"
                                    Fill="#0078D4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="BorderBrush" Value="#8A8A8A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#EDEDED" />
                                <Setter TargetName="Dot" Property="BorderBrush" Value="#0078D4" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5A5A5A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 属性面板卡片 -->
        <Style x:Key="InspectorCard" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="BorderBrush" Value="#303030" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#AAAAAA" />
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#666666" />
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#AAAAAA" />
        </Style>

        <!-- 快捷键说明行（两列自适应，说明文字自动换行） -->
        <Style x:Key="ShortcutKey" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="Margin" Value="0,0,10,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="ShortcutDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <!--  Row 0: 顶部命令栏（流式布局，窄窗口自动折行）  -->
            <RowDefinition Height="Auto" />
            <!--  Row 1: 主工作区  -->
            <RowDefinition Height="*" />
            <!--  Row 2: 底部状态栏（流式布局，窄窗口自动折行）  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             Row 0：顶部命令栏
             ═══════════════════════════════════════════════════════════════ -->
        <Border
            Grid.Row="0"
            Background="#1D1D1D"
            BorderBrush="#2D2D2D"
            BorderThickness="0,0,0,1"
            Padding="12,5">
            <WrapPanel x:Name="TopCommandBar">

                <!--  品牌标识  -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock
                        Text="AutoCutPic"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="#E8E8E8"
                        VerticalAlignment="Center"
                        Margin="0,3,6,3" />
                    <TextBlock
                        Text="冲印工作台"
                        FontSize="11"
                        Foreground="#5F5F5F"
                        VerticalAlignment="Center"
                        Margin="0,3,0,3" />
                </StackPanel>

                <Border Style="{StaticResource VerticalRule}" />

                <!--  视图模式切换  -->
                <Border
                    Background="#232323"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="2"
                    Margin="0,3,8,3"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            GroupName="ViewModeGroup"
                            Style="{StaticResource SegmentedToggleItem}"
                            Content="单张精调"
                            IsChecked="{Binding CurrentViewMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Single}" />
                        <RadioButton
                            GroupName="ViewModeGroup"
                            Style="{StaticResource SegmentedToggleItem}"
                            Content="平铺总览"
                            IsChecked="{Binding CurrentViewMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Batch}" />
                    </StackPanel>
                </Border>

                <!--  导入与工程  -->
                <Button
                    Content="导入照片"
                    Click="SelectFolder_Click"
                    Style="{StaticResource PrimaryActionButton}" />
                <Button
                    Content="添加文件"
                    Click="SelectFiles_Click"
                    Style="{StaticResource ToolbarActionButton}" />
                <Button
                    Content="打开工程"
                    Click="OpenProject_Click"
                    Style="{StaticResource ToolbarActionButton}" />
                <Button
                    Content="保存工程"
                    Click="SaveProject_Click"
                    Style="{StaticResource ToolbarActionButton}" />

                <Border Style="{StaticResource VerticalRule}" />

                <!--  免修照片过滤（标签与单选项作为整体折行，避免标签孤立在上一行）  -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="免修" Style="{StaticResource ToolbarLabel}" />
                    <RadioButton
                        GroupName="MatchedFilterGroup"
                        Style="{StaticResource CompactRadio}"
                        Content="全部"
                        IsChecked="{Binding ShowAllPhotos}" />
                    <RadioButton
                        GroupName="MatchedFilterGroup"
                        Style="{StaticResource CompactRadio}"
                        Content="淡化"
                        IsChecked="{Binding DimMatchedPhotos}" />
                    <RadioButton
                        GroupName="MatchedFilterGroup"
                        Style="{StaticResource CompactRadio}"
                        Content="隐藏"
                        IsChecked="{Binding HideMatchedPhotos}" />
                </StackPanel>

                <!--  紧凑布局下的属性面板开关（宽窗口自动隐藏）  -->
                <Button
                    x:Name="PropertyPanelToggle"
                    Content="属性面板"
                    Click="TogglePropertyPanel_Click"
                    Style="{StaticResource ToolbarActionButton}"
                    Margin="4,3,0,3"
                    Visibility="Collapsed" />
            </WrapPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             Row 1：主工作区 + 属性面板
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!--  宽布局下为属性面板预留的停靠位；紧凑布局下由代码折叠为 0  -->
                <ColumnDefinition x:Name="PropertyDockSpacer" Width="320" />
            </Grid.ColumnDefinitions>

            <!--  左侧主工作台（上半部单张大图工作台 + 下半部资源管理器平铺视图）  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- Row 0: 单张精调大图主工作台 (顶部通透无栏阻挡，视野最大化) -->
                    <RowDefinition x:Name="ViewportRow" Height="5*" MinHeight="150" />
                    <!-- Row 1: 上下可拖拽分割条 -->
                    <RowDefinition x:Name="GallerySplitterRow" Height="5" />
                    <!-- Row 2: 资源管理器平铺视图 -->
                    <RowDefinition x:Name="GalleryRow" Height="3*" MinHeight="150" />
                </Grid.RowDefinitions>

                <!--  中央大图主视口（Photoshop 裁切画布工作台）  -->
                <Border
                    x:Name="MainViewportHost"
                    Grid.Row="0"
                    Background="#181818"
                    BorderBrush="#2D2D2D"
                    BorderThickness="0,0,1,0"
                    ClipToBounds="True">
                    <Grid>

                        <!-- 统一工作画板（纯白相纸底板、照片原图、遮罩与 PS 裁切框） -->
                        <Grid
                            x:Name="PhotoCanvas"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Cursor="SizeAll"
                            MouseDown="PhotoCanvas_MouseDown"
                            MouseMove="PhotoCanvas_MouseMove"
                            MouseUp="PhotoCanvas_MouseUp">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem
                                        Header="裁剪填充"
                                        InputGestureText="Fill"
                                        Command="{Binding SetModeCommand}"
                                        CommandParameter="Fill"
                                        IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fill}" />
                                    <MenuItem
                                        Header="留白完整"
                                        InputGestureText="Fit"
                                        Command="{Binding SetModeCommand}"
                                        CommandParameter="Fit"
                                        IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fit}" />
                                    <Separator />
                                    <MenuItem
                                        Header="切换裁切模式"
                                        InputGestureText="F"
                                        Command="{Binding ToggleModeCommand}" />
                                    <MenuItem
                                        Header="切换相纸方向"
                                        InputGestureText="X"
                                        Command="{Binding ToggleOrientationCommand}" />
                                    <MenuItem
                                        Header="恢复默认剪切"
                                        InputGestureText="R"
                                        Command="{Binding ResetCropCommand}" />
                                    <Separator />
                                    <MenuItem
                                        Header="在资源管理器中显示"
                                        Command="{Binding OpenFileInExplorerCommand}"
                                        CommandParameter="{Binding SelectedPhoto}" />
                                    <MenuItem
                                        Header="复制文件完整路径"
                                        Command="{Binding CopyFilePathCommand}"
                                        CommandParameter="{Binding SelectedPhoto}" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPhoto}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- 画板总尺寸动态绑定 -->
                            <Grid.Width>
                                <MultiBinding Converter="{StaticResource PsBoardSizeConverter}" ConverterParameter="Width">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                    <Binding Path="SelectedPhoto.Orientation" />
                                </MultiBinding>
                            </Grid.Width>
                            <Grid.Height>
                                <MultiBinding Converter="{StaticResource PsBoardSizeConverter}" ConverterParameter="Height">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                    <Binding Path="SelectedPhoto.Orientation" />
                                </MultiBinding>
                            </Grid.Height>

                            <!-- 层级 1：纯白相纸底板（在留白模式下显露真实的相纸纯白边，带立体物理阴影） -->
                            <Border
                                Background="#FFFFFF"
                                BorderBrush="#444444"
                                BorderThickness="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource PsPaperSizeConverter}" ConverterParameter="Width">
                                        <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                        <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                        <Binding Path="SelectedPhoto.OriginalWidth" />
                                        <Binding Path="SelectedPhoto.OriginalHeight" />
                                        <Binding Path="SelectedPhoto.OffsetX" />
                                        <Binding Path="SelectedPhoto.OffsetY" />
                                        <Binding Path="SelectedSize" />
                                        <Binding Path="SelectedMode" />
                                        <Binding Path="SelectedPhoto.Orientation" />
                                    </MultiBinding>
                                </Border.Width>
                                <Border.Height>
                                    <MultiBinding Converter="{StaticResource PsPaperSizeConverter}" ConverterParameter="Height">
                                        <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                        <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                        <Binding Path="SelectedPhoto.OriginalWidth" />
                                        <Binding Path="SelectedPhoto.OriginalHeight" />
                                        <Binding Path="SelectedPhoto.OffsetX" />
                                        <Binding Path="SelectedPhoto.OffsetY" />
                                        <Binding Path="SelectedSize" />
                                        <Binding Path="SelectedMode" />
                                        <Binding Path="SelectedPhoto.Orientation" />
                                    </MultiBinding>
                                </Border.Height>
                                <Border.Margin>
                                    <MultiBinding Converter="{StaticResource PsPaperMarginConverter}">
                                        <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                        <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                        <Binding Path="SelectedPhoto.OriginalWidth" />
                                        <Binding Path="SelectedPhoto.OriginalHeight" />
                                        <Binding Path="SelectedPhoto.OffsetX" />
                                        <Binding Path="SelectedPhoto.OffsetY" />
                                        <Binding Path="SelectedSize" />
                                        <Binding Path="SelectedMode" />
                                        <Binding Path="SelectedPhoto.Orientation" />
                                    </MultiBinding>
                                </Border.Margin>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="Black" Opacity="0.55" />
                                </Border.Effect>
                            </Border>

                            <!-- 层级 2：照片原图呈现（Fit 模式居中在纯白相纸上，Fill 模式铺满画板） -->
                            <Image
                                Source="{Binding HighResPreview}"
                                Stretch="Fill"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                                <Image.Width>
                                    <MultiBinding Converter="{StaticResource PsImgSizeConverter}" ConverterParameter="Width">
                                        <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                        <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                        <Binding Path="SelectedPhoto.OriginalWidth" />
                                        <Binding Path="SelectedPhoto.OriginalHeight" />
                                        <Binding Path="SelectedPhoto.OffsetX" />
                                        <Binding Path="SelectedPhoto.OffsetY" />
                                        <Binding Path="SelectedSize" />
                                        <Binding Path="SelectedMode" />
                                        <Binding Path="SelectedPhoto.Orientation" />
                                    </MultiBinding>
                                </Image.Width>
                                <Image.Height>
                                    <MultiBinding Converter="{StaticResource PsImgSizeConverter}" ConverterParameter="Height">
                                        <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                        <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                        <Binding Path="SelectedPhoto.OriginalWidth" />
                                        <Binding Path="SelectedPhoto.OriginalHeight" />
                                        <Binding Path="SelectedPhoto.OffsetX" />
                                        <Binding Path="SelectedPhoto.OffsetY" />
                                        <Binding Path="SelectedSize" />
                                        <Binding Path="SelectedMode" />
                                        <Binding Path="SelectedPhoto.Orientation" />
                                    </MultiBinding>
                                </Image.Height>
                                <Image.Margin>
                                    <MultiBinding Converter="{StaticResource PsImgMarginConverter}">
                                        <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                        <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                        <Binding Path="SelectedPhoto.OriginalWidth" />
                                        <Binding Path="SelectedPhoto.OriginalHeight" />
                                        <Binding Path="SelectedPhoto.OffsetX" />
                                        <Binding Path="SelectedPhoto.OffsetY" />
                                        <Binding Path="SelectedSize" />
                                        <Binding Path="SelectedMode" />
                                        <Binding Path="SelectedPhoto.Orientation" />
                                    </MultiBinding>
                                </Image.Margin>
                            </Image>

                            <!-- 层级 3：照片外围精细描边（确保浅色照片边缘与纯白相纸白边清晰可辨） -->
                            <Border
                                BorderBrush="#35000000"
                                BorderThickness="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource PsImgSizeConverter}" ConverterParameter="Width">
                                        <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                        <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                        <Binding Path="SelectedPhoto.OriginalWidth" />
                                        <Binding Path="SelectedPhoto.OriginalHeight" />
                                        <Binding Path="SelectedPhoto.OffsetX" />
                                        <Binding Path="SelectedPhoto.OffsetY" />
                                        <Binding Path="SelectedSize" />
                                        <Binding Path="SelectedMode" />
                                        <Binding Path="SelectedPhoto.Orientation" />
                                    </MultiBinding>
                                </Border.Width>
                                <Border.Height>
                                    <MultiBinding Converter="{StaticResource PsImgSizeConverter}" ConverterParameter="Height">
                                        <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                        <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                        <Binding Path="SelectedPhoto.OriginalWidth" />
                                        <Binding Path="SelectedPhoto.OriginalHeight" />
                                        <Binding Path="SelectedPhoto.OffsetX" />
                                        <Binding Path="SelectedPhoto.OffsetY" />
                                        <Binding Path="SelectedSize" />
                                        <Binding Path="SelectedMode" />
                                        <Binding Path="SelectedPhoto.Orientation" />
                                    </MultiBinding>
                                </Border.Height>
                                <Border.Margin>
                                    <MultiBinding Converter="{StaticResource PsImgMarginConverter}">
                                        <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                        <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                        <Binding Path="SelectedPhoto.OriginalWidth" />
                                        <Binding Path="SelectedPhoto.OriginalHeight" />
                                        <Binding Path="SelectedPhoto.OffsetX" />
                                        <Binding Path="SelectedPhoto.OffsetY" />
                                        <Binding Path="SelectedSize" />
                                        <Binding Path="SelectedMode" />
                                        <Binding Path="SelectedPhoto.Orientation" />
                                    </MultiBinding>
                                </Border.Margin>
                            </Border>

                            <!-- 层级 4：Fill 模式下相纸外部暗色遮罩（Fit 模式下为空，绝不遮挡纯白留白） -->
                            <Path Fill="#99000000" IsHitTestVisible="False">
                                <Path.Data>
                                    <MultiBinding Converter="{StaticResource PsCropMaskConverter}">
                                        <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                        <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                        <Binding Path="SelectedPhoto.OriginalWidth" />
                                        <Binding Path="SelectedPhoto.OriginalHeight" />
                                        <Binding Path="SelectedPhoto.OffsetX" />
                                        <Binding Path="SelectedPhoto.OffsetY" />
                                        <Binding Path="SelectedSize" />
                                        <Binding Path="SelectedMode" />
                                        <Binding Path="SelectedPhoto.Orientation" />
                                        <Binding Path="SelectedPhoto.CropScale" />
                                    </MultiBinding>
                                </Path.Data>
                            </Path>

                            <!-- 层级 5：Photoshop 裁切取景框（高反差边框 + 四角直角手柄 + 边框拖拽热区） -->
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Grid.Width>
                                    <MultiBinding Converter="{StaticResource PsPaperSizeConverter}" ConverterParameter="Width">
                                        <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                        <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                        <Binding Path="SelectedPhoto.OriginalWidth" />
                                        <Binding Path="SelectedPhoto.OriginalHeight" />
                                        <Binding Path="SelectedPhoto.OffsetX" />
                                        <Binding Path="SelectedPhoto.OffsetY" />
                                        <Binding Path="SelectedSize" />
                                        <Binding Path="SelectedMode" />
                                        <Binding Path="SelectedPhoto.Orientation" />
                                        <Binding Path="SelectedPhoto.CropScale" />
                                    </MultiBinding>
                                </Grid.Width>
                                <Grid.Height>
                                    <MultiBinding Converter="{StaticResource PsPaperSizeConverter}" ConverterParameter="Height">
                                        <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                        <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                        <Binding Path="SelectedPhoto.OriginalWidth" />
                                        <Binding Path="SelectedPhoto.OriginalHeight" />
                                        <Binding Path="SelectedPhoto.OffsetX" />
                                        <Binding Path="SelectedPhoto.OffsetY" />
                                        <Binding Path="SelectedSize" />
                                        <Binding Path="SelectedMode" />
                                        <Binding Path="SelectedPhoto.Orientation" />
                                        <Binding Path="SelectedPhoto.CropScale" />
                                    </MultiBinding>
                                </Grid.Height>
                                <Grid.Margin>
                                    <MultiBinding Converter="{StaticResource PsPaperMarginConverter}">
                                        <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                        <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                        <Binding Path="SelectedPhoto.OriginalWidth" />
                                        <Binding Path="SelectedPhoto.OriginalHeight" />
                                        <Binding Path="SelectedPhoto.OffsetX" />
                                        <Binding Path="SelectedPhoto.OffsetY" />
                                        <Binding Path="SelectedSize" />
                                        <Binding Path="SelectedMode" />
                                        <Binding Path="SelectedPhoto.Orientation" />
                                        <Binding Path="SelectedPhoto.CropScale" />
                                    </MultiBinding>
                                </Grid.Margin>

                                <!-- 内部取景区域（按住平移整个裁切框） -->
                                <Border
                                    Tag="All"
                                    Background="#01000000"
                                    Cursor="SizeAll"
                                    MouseDown="CropHandle_MouseDown"
                                    MouseMove="CropHandle_MouseMove"
                                    MouseUp="CropHandle_MouseUp" />

                                <!-- 外框双层高反差细实线（外黑内白，在任何深浅背景上都极度清晰，穿透鼠标） -->
                                <Border
                                    Margin="-1"
                                    BorderBrush="#80000000"
                                    BorderThickness="2"
                                    IsHitTestVisible="False" />
                                <Border
                                    BorderBrush="#F0FFFFFF"
                                    BorderThickness="1"
                                    IsHitTestVisible="False" />

                                <!-- 边框交互拖拽热区（四条边：宽 14px，鼠标放上去呈现双向调节光标） -->
                                <Border
                                    Tag="Top"
                                    Height="14"
                                    Margin="16,-7,16,0"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    Cursor="SizeNS"
                                    MouseDown="CropHandle_MouseDown"
                                    MouseMove="CropHandle_MouseMove"
                                    MouseUp="CropHandle_MouseUp" />
                                <Border
                                    Tag="Bottom"
                                    Height="14"
                                    Margin="16,0,16,-7"
                                    VerticalAlignment="Bottom"
                                    Background="Transparent"
                                    Cursor="SizeNS"
                                    MouseDown="CropHandle_MouseDown"
                                    MouseMove="CropHandle_MouseMove"
                                    MouseUp="CropHandle_MouseUp" />
                                <Border
                                    Tag="Left"
                                    Width="14"
                                    Margin="-7,16,0,16"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    Cursor="SizeWE"
                                    MouseDown="CropHandle_MouseDown"
                                    MouseMove="CropHandle_MouseMove"
                                    MouseUp="CropHandle_MouseUp" />
                                <Border
                                    Tag="Right"
                                    Width="14"
                                    Margin="0,16,-7,16"
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    Cursor="SizeWE"
                                    MouseDown="CropHandle_MouseDown"
                                    MouseMove="CropHandle_MouseMove"
                                    MouseUp="CropHandle_MouseUp" />

                                <!-- PS 风格四角折角视觉与拖拽手柄 -->
                                <Grid
                                    Tag="TopLeft"
                                    Width="32"
                                    Height="32"
                                    Margin="-6,-6,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="#01000000"
                                    Cursor="SizeNWSE"
                                    MouseDown="CropHandle_MouseDown"
                                    MouseMove="CropHandle_MouseMove"
                                    MouseUp="CropHandle_MouseUp">
                                    <Path
                                        Data="M 4,20 L 4,4 L 20,4"
                                        Stroke="White"
                                        StrokeThickness="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="2,2,0,0"
                                        IsHitTestVisible="False" />
                                </Grid>
                                <Grid
                                    Tag="TopRight"
                                    Width="32"
                                    Height="32"
                                    Margin="0,-6,-6,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="#01000000"
                                    Cursor="SizeNESW"
                                    MouseDown="CropHandle_MouseDown"
                                    MouseMove="CropHandle_MouseMove"
                                    MouseUp="CropHandle_MouseUp">
                                    <Path
                                        Data="M 12,4 L 28,4 L 28,20"
                                        Stroke="White"
                                        StrokeThickness="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,2,2,0"
                                        IsHitTestVisible="False" />
                                </Grid>
                                <Grid
                                    Tag="BottomLeft"
                                    Width="32"
                                    Height="32"
                                    Margin="-6,0,0,-6"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Background="#01000000"
                                    Cursor="SizeNESW"
                                    MouseDown="CropHandle_MouseDown"
                                    MouseMove="CropHandle_MouseMove"
                                    MouseUp="CropHandle_MouseUp">
                                    <Path
                                        Data="M 4,12 L 4,28 L 20,28"
                                        Stroke="White"
                                        StrokeThickness="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Margin="2,0,0,2"
                                        IsHitTestVisible="False" />
                                </Grid>
                                <Grid
                                    Tag="BottomRight"
                                    Width="32"
                                    Height="32"
                                    Margin="0,0,-6,-6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="#01000000"
                                    Cursor="SizeNWSE"
                                    MouseDown="CropHandle_MouseDown"
                                    MouseMove="CropHandle_MouseMove"
                                    MouseUp="CropHandle_MouseUp">
                                    <Path
                                        Data="M 12,28 L 28,28 L 28,12"
                                        Stroke="White"
                                        StrokeThickness="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,2,2"
                                        IsHitTestVisible="False" />
                                </Grid>

                                <!-- PS 风格四边中心手柄 (可直接按住拖拽调节单方向裁切) -->
                                <Grid
                                    Tag="Top"
                                    Width="28"
                                    Height="14"
                                    Margin="0,-5,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    Cursor="SizeNS"
                                    MouseDown="CropHandle_MouseDown"
                                    MouseMove="CropHandle_MouseMove"
                                    MouseUp="CropHandle_MouseUp">
                                    <Rectangle
                                        Width="16"
                                        Height="3"
                                        Fill="White"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False" />
                                </Grid>
                                <Grid
                                    Tag="Bottom"
                                    Width="28"
                                    Height="14"
                                    Margin="0,0,0,-5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Background="Transparent"
                                    Cursor="SizeNS"
                                    MouseDown="CropHandle_MouseDown"
                                    MouseMove="CropHandle_MouseMove"
                                    MouseUp="CropHandle_MouseUp">
                                    <Rectangle
                                        Width="16"
                                        Height="3"
                                        Fill="White"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False" />
                                </Grid>
                                <Grid
                                    Tag="Left"
                                    Width="14"
                                    Height="28"
                                    Margin="-5,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Cursor="SizeWE"
                                    MouseDown="CropHandle_MouseDown"
                                    MouseMove="CropHandle_MouseMove"
                                    MouseUp="CropHandle_MouseUp">
                                    <Rectangle
                                        Width="3"
                                        Height="16"
                                        Fill="White"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False" />
                                </Grid>
                                <Grid
                                    Tag="Right"
                                    Width="14"
                                    Height="28"
                                    Margin="0,0,-5,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Cursor="SizeWE"
                                    MouseDown="CropHandle_MouseDown"
                                    MouseMove="CropHandle_MouseMove"
                                    MouseUp="CropHandle_MouseUp">
                                    <Rectangle
                                        Width="3"
                                        Height="16"
                                        Fill="White"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False" />
                                </Grid>
                            </Grid>
                        </Grid>

                        <!--  大图工作台空状态提示（未选中照片但已导入时）  -->
                        <TextBlock
                            Text="从下方平铺视图选择一张照片开始精调"
                            FontSize="12"
                            Foreground="#4A4A4A"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPhoto}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </Grid>
                </Border>

                <!-- Row 1: 上下可拖拽分割条 -->
                <GridSplitter
                    x:Name="WorkspaceSplitter"
                    Grid.Row="1"
                    Height="5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="#252526"
                    ShowsPreview="False"
                    Cursor="SizeNS" />

                <!-- Row 2: 资源管理器平铺视图 (流式工具栏 + 多行垂直上下滚动) -->
                <Border
                    x:Name="BatchGalleryHost"
                    Grid.Row="2"
                    Background="#141414"
                    BorderBrush="#2D2D2D"
                    BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 平铺视图控制工具栏（流式换行，窄窗口绝不重叠） -->
                        <Border
                            Grid.Row="0"
                            Background="#1B1B1B"
                            BorderBrush="#282828"
                            BorderThickness="0,0,0,1"
                            Padding="12,4">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="缩放" Style="{StaticResource ToolbarLabel}" />
                                <Slider
                                    Width="96"
                                    Margin="0,3,14,3"
                                    Minimum="80"
                                    Maximum="300"
                                    Value="{Binding GalleryCardWidth}"
                                    VerticalAlignment="Center"
                                    Focusable="False" />

                                <TextBlock
                                    Text="{Binding Photos.Count, StringFormat='共 {0} 张'}"
                                    Foreground="#555555"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    Margin="0,3,14,3" />
                                <TextBlock
                                    Text="{Binding NeedAdjustCount, StringFormat='{}{0} 张需调整'}"
                                    Foreground="#B0B0B0"
                                    FontWeight="Medium"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    Margin="0,3,14,3" />
                            </WrapPanel>
                        </Border>

                        <ListBox
                            x:Name="BatchGalleryList"
                            Grid.Row="1"
                            ItemsSource="{Binding Photos}"
                            SelectedItem="{Binding SelectedPhoto}"
                            SelectionMode="Extended"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="12,10"
                            IsTextSearchEnabled="False"
                            KeyboardNavigation.DirectionalNavigation="None"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.CanContentScroll="False"
                            PreviewMouseDown="BatchGalleryList_PreviewMouseDown"
                            PreviewMouseWheel="BatchGalleryList_PreviewMouseWheel"
                            MouseDoubleClick="BatchGalleryList_MouseDoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="4" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Visibility">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource HideMatchedVisibilityConverter}">
                                                <Binding Path="IsAspectMatched" />
                                                <Binding Path="DataContext.HideMatchedPhotos" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- 资源管理器风格平铺照片卡片 (紧凑饱满自适应) -->
                                    <Border
                                        Width="{Binding DataContext.GalleryCardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding DataContext.GalleryCardHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Background="#1E1E1E"
                                        BorderThickness="2"
                                        CornerRadius="4"
                                        Cursor="Hand"
                                        PreviewMouseRightButtonDown="PhotoCard_PreviewMouseRightButtonDown">
                                        <Border.Visibility>
                                            <MultiBinding Converter="{StaticResource HideMatchedVisibilityConverter}">
                                                <Binding Path="IsAspectMatched" />
                                                <Binding Path="DataContext.HideMatchedPhotos" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </Border.Visibility>
                                        <Border.Opacity>
                                            <MultiBinding Converter="{StaticResource DimMatchedOpacityConverter}">
                                                <Binding Path="IsAspectMatched" />
                                                <Binding Path="DataContext.DimMatchedPhotos" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </Border.Opacity>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem
                                                    Header="裁剪填充"
                                                    InputGestureText="Fill"
                                                    Command="{Binding DataContext.SetModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="Fill"
                                                    IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fill}" />
                                                <MenuItem
                                                    Header="留白完整"
                                                    InputGestureText="Fit"
                                                    Command="{Binding DataContext.SetModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="Fit"
                                                    IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fit}" />
                                                <Separator />
                                                <MenuItem
                                                    Header="切换相纸方向"
                                                    InputGestureText="X"
                                                    Command="{Binding DataContext.ToggleOrientationCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <MenuItem
                                                    Header="恢复默认剪切"
                                                    InputGestureText="R"
                                                    Command="{Binding DataContext.ResetCropCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem
                                                    Header="在资源管理器中显示"
                                                    Command="{Binding DataContext.OpenFileInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                                <MenuItem
                                                    Header="复制文件完整路径"
                                                    Command="{Binding DataContext.CopyFilePathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#2F2F2F" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#555555" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#0078D4" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="{Binding DataContext.GalleryImageContainerHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- 照片视口展示区 (自然居中) -->
                                            <Border
                                                Grid.Row="0"
                                                Background="Transparent"
                                                CornerRadius="3,3,0,0"
                                                ClipToBounds="True">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid.Width>
                                                        <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="ContainerWidth">
                                                            <Binding Path="OriginalWidth" />
                                                            <Binding Path="OriginalHeight" />
                                                            <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="Mode" />
                                                            <Binding Path="OffsetX" />
                                                            <Binding Path="OffsetY" />
                                                            <Binding Path="Orientation" />
                                                            <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="CropScale" />
                                                        </MultiBinding>
                                                    </Grid.Width>
                                                    <Grid.Height>
                                                        <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="ContainerHeight">
                                                            <Binding Path="OriginalWidth" />
                                                            <Binding Path="OriginalHeight" />
                                                            <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="Mode" />
                                                            <Binding Path="OffsetX" />
                                                            <Binding Path="OffsetY" />
                                                            <Binding Path="Orientation" />
                                                            <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="CropScale" />
                                                        </MultiBinding>
                                                    </Grid.Height>

                                                    <!-- Fit 模式纯白相纸底板 -->
                                                    <Border
                                                        Background="#FFFFFF"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top">
                                                        <Border.Visibility>
                                                            <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="FitPaperVisibility">
                                                                <Binding Path="OriginalWidth" />
                                                                <Binding Path="OriginalHeight" />
                                                                <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="Mode" />
                                                                <Binding Path="OffsetX" />
                                                                <Binding Path="OffsetY" />
                                                                <Binding Path="Orientation" />
                                                                <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="CropScale" />
                                                            </MultiBinding>
                                                        </Border.Visibility>
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="CropWidth">
                                                                <Binding Path="OriginalWidth" />
                                                                <Binding Path="OriginalHeight" />
                                                                <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="Mode" />
                                                                <Binding Path="OffsetX" />
                                                                <Binding Path="OffsetY" />
                                                                <Binding Path="Orientation" />
                                                                <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="CropScale" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                        <Border.Height>
                                                            <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="CropHeight">
                                                                <Binding Path="OriginalWidth" />
                                                                <Binding Path="OriginalHeight" />
                                                                <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="Mode" />
                                                                <Binding Path="OffsetX" />
                                                                <Binding Path="OffsetY" />
                                                                <Binding Path="Orientation" />
                                                                <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="CropScale" />
                                                            </MultiBinding>
                                                        </Border.Height>
                                                        <Border.Margin>
                                                            <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="CropMargin">
                                                                <Binding Path="OriginalWidth" />
                                                                <Binding Path="OriginalHeight" />
                                                                <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="Mode" />
                                                                <Binding Path="OffsetX" />
                                                                <Binding Path="OffsetY" />
                                                                <Binding Path="Orientation" />
                                                                <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="CropScale" />
                                                            </MultiBinding>
                                                        </Border.Margin>
                                                    </Border>

                                                    <!-- 完整照片原图呈现 -->
                                                    <Image
                                                        Source="{Binding Thumbnail}"
                                                        Stretch="Fill"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        RenderOptions.BitmapScalingMode="LowQuality">
                                                        <Image.Width>
                                                            <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="ImageWidth">
                                                                <Binding Path="OriginalWidth" />
                                                                <Binding Path="OriginalHeight" />
                                                                <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="Mode" />
                                                                <Binding Path="OffsetX" />
                                                                <Binding Path="OffsetY" />
                                                                <Binding Path="Orientation" />
                                                                <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="CropScale" />
                                                            </MultiBinding>
                                                        </Image.Width>
                                                        <Image.Height>
                                                            <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="ImageHeight">
                                                                <Binding Path="OriginalWidth" />
                                                                <Binding Path="OriginalHeight" />
                                                                <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="Mode" />
                                                                <Binding Path="OffsetX" />
                                                                <Binding Path="OffsetY" />
                                                                <Binding Path="Orientation" />
                                                                <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="CropScale" />
                                                            </MultiBinding>
                                                        </Image.Height>
                                                        <Image.Margin>
                                                            <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="ImageMargin">
                                                                <Binding Path="OriginalWidth" />
                                                                <Binding Path="OriginalHeight" />
                                                                <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="Mode" />
                                                                <Binding Path="OffsetX" />
                                                                <Binding Path="OffsetY" />
                                                                <Binding Path="Orientation" />
                                                                <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="CropScale" />
                                                            </MultiBinding>
                                                        </Image.Margin>
                                                    </Image>

                                                    <!-- Fill 模式下：被裁切掉的外围区域暗色半透明遮罩 (清楚可见被裁切掉的内容) -->
                                                    <Path Fill="#A0000000" IsHitTestVisible="False">
                                                        <Path.Data>
                                                            <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="MaskGeometry">
                                                                <Binding Path="OriginalWidth" />
                                                                <Binding Path="OriginalHeight" />
                                                                <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="Mode" />
                                                                <Binding Path="OffsetX" />
                                                                <Binding Path="OffsetY" />
                                                                <Binding Path="Orientation" />
                                                                <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="CropScale" />
                                                            </MultiBinding>
                                                        </Path.Data>
                                                    </Path>
                                                </Grid>
                                            </Border>

                                            <!-- 卡片底部元数据 (文件名与尺寸完整展示) -->
                                            <Grid
                                                Grid.Row="1"
                                                Margin="6,2,6,2"
                                                VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- 第一行：完整/紧凑文件名 -->
                                                <TextBlock
                                                    Grid.Row="0"
                                                    Text="{Binding FileName}"
                                                    Foreground="#D0D0D0"
                                                    FontSize="11"
                                                    FontWeight="Medium"
                                                    TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- 第二行：真实像素分辨率 -->
                                                <TextBlock
                                                    Grid.Row="1"
                                                    FontSize="9"
                                                    Foreground="#606060"
                                                    Margin="0,1,0,0">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} × {1}">
                                                            <Binding Path="OriginalWidth" />
                                                            <Binding Path="OriginalHeight" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 鼠标中键自动平滑滚动指示器 (严格居中对称，完全对齐) -->
                        <Canvas x:Name="AutoScrollCanvas" IsHitTestVisible="False">
                            <Grid
                                x:Name="AutoScrollAnchor"
                                Width="32"
                                Height="32"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                                <!-- 外层深色半透明圆环 -->
                                <Ellipse
                                    Width="32"
                                    Height="32"
                                    Fill="#E6202020"
                                    Stroke="#99FFFFFF"
                                    StrokeThickness="1.5" />
                                <!-- 中心圆点 (严格位于 16, 16) -->
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    Fill="#FFFFFF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <!-- 上下滚动精准居中对称箭头 (X轴在 16 对称，左右跨度各 5px: 11 与 21) -->
                                <Path
                                    Data="M 11,10 L 16,5 L 21,10 M 11,22 L 16,27 L 21,22"
                                    Stroke="#FFFFFF"
                                    StrokeThickness="1.5"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top" />
                            </Grid>
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>

            <!--  紧凑布局下的抽屉遮罩（点击关闭属性面板）  -->
            <Border
                x:Name="PropertyScrim"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="#99000000"
                Visibility="Collapsed"
                MouseLeftButtonDown="PropertyScrim_MouseLeftButtonDown" />

            <!--  属性设置面板：宽布局停靠右侧，紧凑布局成为右侧滑出抽屉  -->
            <Border
                x:Name="PropertyPanel"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Width="320"
                HorizontalAlignment="Right"
                Background="#232323"
                BorderBrush="#2D2D2D"
                BorderThickness="1,0,0,0"
                Padding="14">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="18"
                        ShadowDepth="0"
                        Direction="180"
                        Color="#000000"
                        Opacity="0.6" />
                </Border.Effect>
                <DockPanel LastChildFill="True">
                    <!-- 底部批量导出按钮与状态信息 -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <!-- 导出与取消按钮容器 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Style="{StaticResource ExportActionButton}"
                                Command="{Binding ExportCommand}"
                                Content="批量开始导出" />

                            <Button
                                Grid.Column="1"
                                Style="{StaticResource AbortActionButton}"
                                Command="{Binding CancelExportCommand}"
                                Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}"
                                Content="中止" />
                        </Grid>

                        <!-- 导出进度指示器 -->
                        <ProgressBar
                            Height="4"
                            Margin="0,8,0,0"
                            Background="#333333"
                            Foreground="#0078D4"
                            BorderThickness="0"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding ExportProgress}"
                            Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}" />

                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="#888888"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Text="输出目录: 原图同级 Clipped_Photos" />

                        <!--  导出专属文案：全局 StatusText 只归底部状态栏，此处不再重复呈现  -->
                        <TextBlock
                            Margin="0,6,0,0"
                            Foreground="#CCCCCC"
                            FontSize="12"
                            FontWeight="Medium"
                            TextWrapping="Wrap"
                            Text="{Binding ExportStatusText}" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!--  面板标题 + 紧凑模式关闭按钮  -->
                            <Grid Margin="0,0,0,12">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="#EEEEEE"
                                    VerticalAlignment="Center"
                                    Text="冲印设置" />
                                <Button
                                    x:Name="PropertyPanelCloseButton"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="24"
                                    Height="24"
                                    Margin="0"
                                    Padding="0"
                                    Background="#2B2B2B"
                                    Foreground="#CCCCCC"
                                    BorderBrush="#3E3E42"
                                    BorderThickness="1"
                                    FontSize="13"
                                    Cursor="Hand"
                                    Click="ClosePropertyPanel_Click"
                                    Content="✕"
                                    Visibility="Collapsed" />
                            </Grid>

                            <!-- 当前照片信息卡片 -->
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource InspectorCard}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPhoto}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="当前照片" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Text="{Binding SelectedPhoto.FileName}"
                                        Foreground="#FFFFFF"
                                        FontWeight="Medium"
                                        FontSize="12"
                                        TextTrimming="CharacterEllipsis" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource CaptionText}" Text="原图像素 " />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding SelectedPhoto.OriginalWidth}" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text=" × " />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding SelectedPhoto.OriginalHeight}" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text=" px" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InspectorCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="相纸规格 (300 DPI)" />
                                    <ComboBox
                                        Margin="0,8,0,8"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{Binding Sizes}"
                                        SelectedItem="{Binding SelectedSize}"
                                        Height="28" />
                                    <WrapPanel>
                                        <TextBlock Style="{StaticResource CaptionText}" Text="输出像素 " />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding SelectedSize.PixelWidth}" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text=" × " />
                                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding SelectedSize.PixelHeight}" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text=" px" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InspectorCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="裁切排版" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <RadioButton
                                            Style="{StaticResource CompactRadio}"
                                            Content="裁剪填充 (Fill)"
                                            IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fill}" />
                                        <RadioButton
                                            Style="{StaticResource CompactRadio}"
                                            Content="留白完整 (Fit)"
                                            IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fit}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InspectorCard}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="裁切相纸方向" />
                                        <Button
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="#2B2B2B"
                                            Foreground="#CCCCCC"
                                            BorderBrush="#3E3E42"
                                            BorderThickness="1"
                                            Padding="6,2"
                                            Margin="0"
                                            Height="22"
                                            Cursor="Hand"
                                            FontSize="10"
                                            Command="{Binding ToggleOrientationCommand}"
                                            Content="翻转 (X)">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="3" />
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Text="{Binding SelectedPhoto.Orientation, Converter={StaticResource OrientationToDisplayConverter}}"
                                        Foreground="#EEEEEE"
                                        FontWeight="Medium"
                                        FontSize="12" />
                                </StackPanel>
                            </Border>

                            <Border
                                Background="#1A1A1A"
                                BorderBrush="#2C2C2C"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#888888"
                                        Text="操作快捷键" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Style="{StaticResource ShortcutKey}"
                                            Foreground="#0078D4"
                                            FontWeight="Medium"
                                            Text="G / 双击" />
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Style="{StaticResource ShortcutDesc}"
                                            Text="切换平铺总览 / 单张精调" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Style="{StaticResource ShortcutKey}"
                                            Text="Enter / Esc" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{StaticResource ShortcutDesc}"
                                            Text="打开单张精调 / 返回网格" />

                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Style="{StaticResource ShortcutKey}"
                                            Text="Q / E" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Style="{StaticResource ShortcutDesc}"
                                            Text="切换上一张 / 下一张照片" />

                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Style="{StaticResource ShortcutKey}"
                                            Text="F / 空格" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Style="{StaticResource ShortcutDesc}"
                                            Text="切换裁剪填充 / 留白模式" />

                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Style="{StaticResource ShortcutKey}"
                                            Text="X 键" />
                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Style="{StaticResource ShortcutDesc}"
                                            Text="翻转相纸裁切方向" />

                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="0"
                                            Style="{StaticResource ShortcutKey}"
                                            Text="WASD / 方向键" />
                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            Style="{StaticResource ShortcutDesc}"
                                            Text="构图微调 (Shift 加速 / Ctrl 贴边)" />

                                        <TextBlock
                                            Grid.Row="6"
                                            Grid.Column="0"
                                            Style="{StaticResource ShortcutKey}"
                                            Text="R 键" />
                                        <TextBlock
                                            Grid.Row="6"
                                            Grid.Column="1"
                                            Style="{StaticResource ShortcutDesc}"
                                            Text="恢复默认剪切构图" />

                                        <TextBlock
                                            Grid.Row="7"
                                            Grid.Column="0"
                                            Style="{StaticResource ShortcutKey}"
                                            Foreground="#4EC9B0"
                                            FontWeight="Medium"
                                            Text="Ctrl + S / O" />
                                        <TextBlock
                                            Grid.Row="7"
                                            Grid.Column="1"
                                            Style="{StaticResource ShortcutDesc}"
                                            Text="保存 / 打开工程" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             Row 2：底部状态栏（流式布局，窄窗口自动折行）
             ═══════════════════════════════════════════════════════════════ -->
        <Border
            Grid.Row="2"
            Background="#181818"
            BorderBrush="#2D2D2D"
            BorderThickness="0,1,0,0"
            Padding="12,5">
            <WrapPanel x:Name="StatusBar">
                <TextBlock
                    Text="{Binding StatusText}"
                    Foreground="#CFCFCF"
                    FontSize="11"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    MaxWidth="420"
                    Margin="0,3,16,3" />
                <TextBlock
                    Text="{Binding AutoSaveStatusText}"
                    Foreground="#777777"
                    FontSize="11"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    MaxWidth="240"
                    Margin="0,3,16,3" />
                <TextBlock
                    Text="{Binding PreExportStatusText}"
                    Foreground="#569CD6"
                    FontSize="11"
                    VerticalAlignment="Center"
                    Margin="0,3,16,3" />

                <!--  导入进度交由全局载入遮罩单独呈现：该遮罩在加载期间覆盖整窗，
                     状态栏再放一份只会被完全遮住，属于重复且不可见的死 UI  -->

                <!--  裁剪工作总体进度  -->
                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,3,16,3"
                    Visibility="{Binding HasPhotos, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="进度" Style="{StaticResource ToolbarLabel}" Margin="0,0,6,0" />
                    <ProgressBar
                        Width="90"
                        Height="4"
                        Background="#2B2B2B"
                        Foreground="#0078D4"
                        BorderThickness="0"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding OverallProgressPercent, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0" />
                    <TextBlock
                        Text="{Binding OverallProgressText}"
                        Foreground="#D4D4D4"
                        FontWeight="Medium"
                        FontSize="11"
                        VerticalAlignment="Center" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!--  边界提示浮层（切换首/尾照片时短暂浮现，不拦截任何输入）  -->
        <Border
            x:Name="ToastHost"
            Grid.Row="0"
            Grid.RowSpan="3"
            Panel.ZIndex="600"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,72"
            Padding="18,9"
            Background="#F02A2A2A"
            BorderBrush="#4E4E4E"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="Collapsed"
            IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="16"
                    ShadowDepth="2"
                    Direction="270"
                    Color="#000000"
                    Opacity="0.6" />
            </Border.Effect>
            <TextBlock
                x:Name="ToastText"
                Foreground="#F0F0F0"
                FontSize="12"
                FontWeight="Medium" />
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             全屏导入引导层 (当未导入照片时呈现)
             ═══════════════════════════════════════════════════════════════ -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="#181818"
            Panel.ZIndex="500">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDropOverlayVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MaxWidth="880" MinHeight="360" Margin="28">
                    <Rectangle
                        Stroke="#2E2E2E"
                        StrokeThickness="1.5"
                        StrokeDashArray="6 6"
                        RadiusX="8"
                        RadiusY="8"
                        IsHitTestVisible="False" />

                    <StackPanel
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Border
                            Width="72"
                            Height="72"
                            Margin="0,0,0,18"
                            Background="#252526"
                            BorderBrush="#383838"
                            BorderThickness="1"
                            CornerRadius="36"
                            HorizontalAlignment="Center">
                            <Path
                                Width="28"
                                Height="28"
                                Data="M 0,14 L 28,14 M 14,0 L 14,28"
                                Stroke="#0078D4"
                                StrokeThickness="3"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <TextBlock
                            Text="拖拽照片或文件夹至此"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18" />

                        <!--  上次工作区草稿恢复提示（仅提示，绝不自动载入）  -->
                        <Border
                            Background="#1B2733"
                            BorderBrush="#2F6FA8"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10"
                            MinWidth="320"
                            MaxWidth="560"
                            Margin="0,0,0,18"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasRecoverableDraft, Converter={StaticResource BoolToVis}}">
                            <DockPanel LastChildFill="True">
                                <StackPanel
                                    DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="14,0,0,0">
                                    <Button
                                        Content="恢复"
                                        Style="{StaticResource PrimaryActionButton}"
                                        Command="{Binding RestoreDraftCommand}"
                                        Margin="0,0,8,0" />
                                    <Button
                                        Content="丢弃"
                                        Style="{StaticResource ToolbarActionButton}"
                                        Command="{Binding DiscardDraftCommand}"
                                        Margin="0" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        Text="发现上次未完成的工作区"
                                        Foreground="#CFE4F5"
                                        FontSize="12"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="{Binding RecoverableDraftText}"
                                        Foreground="#8FA9BE"
                                        FontSize="11"
                                        TextWrapping="Wrap"
                                        Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <WrapPanel
                            HorizontalAlignment="Center"
                            Margin="0,0,0,22">
                            <Button
                                Width="150"
                                Height="40"
                                Margin="0,4,12,4"
                                Background="#0078D4"
                                Foreground="#FFFFFF"
                                FontSize="13"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SelectFolder_Click"
                                Content="导入照片文件夹">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button
                                Width="150"
                                Height="40"
                                Margin="0,4"
                                Background="#2A2A2A"
                                Foreground="#CCCCCC"
                                FontSize="13"
                                FontWeight="SemiBold"
                                BorderBrush="#444444"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="SelectFiles_Click"
                                Content="添加照片文件">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </WrapPanel>

                        <WrapPanel HorizontalAlignment="Center">
                            <Border
                                Background="#252526"
                                BorderBrush="#353535"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,3"
                                Margin="4,3">
                                <TextBlock Text="JPG / JPEG" FontSize="11" Foreground="#AAAAAA" />
                            </Border>
                            <Border
                                Background="#252526"
                                BorderBrush="#353535"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,3"
                                Margin="4,3">
                                <TextBlock Text="PNG" FontSize="11" Foreground="#AAAAAA" />
                            </Border>
                            <Border
                                Background="#252526"
                                BorderBrush="#353535"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,3"
                                Margin="4,3">
                                <TextBlock Text="HEIC" FontSize="11" Foreground="#AAAAAA" />
                            </Border>
                            <Border
                                Background="#252526"
                                BorderBrush="#353535"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,3"
                                Margin="4,3">
                                <TextBlock Text="ZIP (Live Photo)" FontSize="11" Foreground="#AAAAAA" />
                            </Border>
                            <Border
                                Background="#252526"
                                BorderBrush="#353535"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,3"
                                Margin="4,3">
                                <TextBlock Text="WEBP" FontSize="11" Foreground="#AAAAAA" />
                            </Border>
                            <Border
                                Background="#252526"
                                BorderBrush="#353535"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,3"
                                Margin="4,3">
                                <TextBlock Text="TIFF / BMP" FontSize="11" Foreground="#AAAAAA" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!--  全局最高层级载入进度遮罩 (只要处于导入或加载状态，任何场景均在屏幕正中央高对比度呈现)  -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="#A0000000"
            Panel.ZIndex="999"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border
                MaxWidth="420"
                MinWidth="260"
                Margin="24"
                Background="#202020"
                BorderBrush="#3E3E3E"
                BorderThickness="1"
                CornerRadius="8"
                Padding="28,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock
                            Text="正在载入照片"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{Binding LoadingProgress, StringFormat='{}{0:F0}%'}"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="#0078D4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>

                    <ProgressBar
                        Height="8"
                        Background="#2B2B2B"
                        Foreground="#0078D4"
                        BorderThickness="0"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding LoadingProgress}" />

                    <TextBlock
                        Margin="0,14,0,0"
                        Text="{Binding LoadingStatusText}"
                        FontSize="12"
                        Foreground="#AAAAAA"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center"
                        TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
