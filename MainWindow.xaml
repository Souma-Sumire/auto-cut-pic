<Window
    x:Class="AutoCutPic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AutoCutPic"
    xmlns:core="clr-namespace:AutoCutPic.Core"
    Title="AutoCutPic - 专业批量照片裁剪工作台"
    Width="1200"
    Height="820"
    MinWidth="960"
    MinHeight="640"
    Background="#1E1E1E"
    Foreground="#CCCCCC"
    InputMethod.IsInputMethodEnabled="False">
    <Window.Resources>
        <core:ZoomToWidthConverter x:Key="ZoomToWidthConverter" />
        <core:CropMarginConverter x:Key="CropMarginConverter" />
        <core:CropSizeConverter x:Key="CropSizeConverter" />
        <core:CropMaskConverter x:Key="CropMaskConverter" />
        <core:PsBoardSizeConverter x:Key="PsBoardSizeConverter" />
        <core:PsPaperSizeConverter x:Key="PsPaperSizeConverter" />
        <core:PsPaperMarginConverter x:Key="PsPaperMarginConverter" />
        <core:PsImgSizeConverter x:Key="PsImgSizeConverter" />
        <core:PsImgMarginConverter x:Key="PsImgMarginConverter" />
        <core:PsCropMaskConverter x:Key="PsCropMaskConverter" />
        <core:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <core:BatchCardCropConverter x:Key="BatchCardCropConverter" />
        <core:CutModeToDisplayConverter x:Key="CutModeToDisplayConverter" />
        <core:OrientationToDisplayConverter x:Key="OrientationToDisplayConverter" />
        <core:DimMatchedOpacityConverter x:Key="DimMatchedOpacityConverter" />
        <core:HideMatchedVisibilityConverter x:Key="HideMatchedVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 工业风专业暗色上下文菜单与菜单项统一样式 -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="BorderBrush" Value="#3E3E42" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#D4D4D4" />
            <Setter Property="Padding" Value="2,4" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.45" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Separator}">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="Background" Value="#383838" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="{TemplateBinding Height}" Margin="{TemplateBinding Margin}" Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="#D4D4D4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border
                            x:Name="BgBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            Padding="6,0,10,0"
                            Margin="2,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" SharedSizeGroup="MenuItemIconColumn" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumn" />
                                </Grid.ColumnDefinitions>

                                <Path
                                    x:Name="CheckMark"
                                    Grid.Column="0"
                                    Data="M 2 6 L 6 10 L 13 3"
                                    Stroke="#0078D4"
                                    StrokeThickness="1.5"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" />

                                <ContentPresenter
                                    x:Name="HeaderHost"
                                    Grid.Column="1"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True"
                                    VerticalAlignment="Center"
                                    Margin="4,0,12,0" />

                                <TextBlock
                                    x:Name="GestureText"
                                    Grid.Column="2"
                                    Text="{TemplateBinding InputGestureText}"
                                    Foreground="#888888"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="12,0,2,0"
                                    Visibility="Visible" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#33373B" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="CheckMark" Property="Stroke" Value="#38A9FF" />
                                <Setter TargetName="GestureText" Property="Foreground" Value="#BBBBBB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#555555" />
                                <Setter TargetName="GestureText" Property="Foreground" Value="#444444" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工业风单选框样式 -->
        <Style x:Key="IndustrialRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,15,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- 暗黑精致滚动条样式：精细紧凑，杜绝遮挡内容与粗大箭头挤占空间 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="8" />
                    <Setter Property="MinHeight" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#444444" CornerRadius="4" Height="6" VerticalAlignment="Center" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8" />
                    <Setter Property="MinWidth" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#444444" CornerRadius="4" Width="6" HorizontalAlignment="Center" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="290" />
        </Grid.ColumnDefinitions>

        <!--  左侧主工作台（上半部单张大图工作台 + 下半部资源管理器平铺视图）  -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <!-- Row 0: 单张精调大图主工作台 (顶部通透无栏阻挡，视野最大化) -->
                <RowDefinition Height="3*" MinHeight="220" />
                <!-- Row 1: 上下可拖拽分割条 -->
                <RowDefinition Height="5" />
                <!-- Row 2: 资源管理器平铺视图 (包含控制工具栏与多行平铺列表) -->
                <RowDefinition Height="2*" MinHeight="180" />
            </Grid.RowDefinitions>

            <!--  中央大图主视口（Photoshop 裁切画布工作台）  -->
            <Border
                x:Name="MainViewportHost"
                Grid.Row="0"
                Background="#181818"
                BorderBrush="#2D2D2D"
                BorderThickness="0,0,1,0"
                ClipToBounds="True">
                <Grid>

                    <!-- 统一工作画板（纯白相纸底板、照片原图、遮罩与 PS 裁切框） -->
                    <Grid
                        x:Name="PhotoCanvas"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Cursor="SizeAll"
                        MouseDown="PhotoCanvas_MouseDown"
                        MouseMove="PhotoCanvas_MouseMove"
                        MouseUp="PhotoCanvas_MouseUp">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    Header="裁剪填充"
                                    InputGestureText="Fill"
                                    Command="{Binding SetModeCommand}"
                                    CommandParameter="Fill"
                                    IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fill}" />
                                <MenuItem
                                    Header="留白完整"
                                    InputGestureText="Fit"
                                    Command="{Binding SetModeCommand}"
                                    CommandParameter="Fit"
                                    IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fit}" />
                                <Separator />
                                <MenuItem
                                    Header="切换裁切模式"
                                    InputGestureText="F"
                                    Command="{Binding ToggleModeCommand}" />
                                <MenuItem
                                    Header="切换相纸方向"
                                    InputGestureText="X"
                                    Command="{Binding ToggleOrientationCommand}" />
                                <Separator />
                                <MenuItem
                                    Header="在资源管理器中显示"
                                    Command="{Binding OpenFileInExplorerCommand}"
                                    CommandParameter="{Binding SelectedPhoto}" />
                                <MenuItem
                                    Header="复制文件完整路径"
                                    Command="{Binding CopyFilePathCommand}"
                                    CommandParameter="{Binding SelectedPhoto}" />
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPhoto}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- 画板总尺寸动态绑定 -->
                        <Grid.Width>
                            <MultiBinding Converter="{StaticResource PsBoardSizeConverter}" ConverterParameter="Width">
                                <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                <Binding Path="SelectedPhoto.OriginalWidth" />
                                <Binding Path="SelectedPhoto.OriginalHeight" />
                                <Binding Path="SelectedSize" />
                                <Binding Path="SelectedMode" />
                                <Binding Path="SelectedPhoto.Orientation" />
                            </MultiBinding>
                        </Grid.Width>
                        <Grid.Height>
                            <MultiBinding Converter="{StaticResource PsBoardSizeConverter}" ConverterParameter="Height">
                                <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                <Binding Path="SelectedPhoto.OriginalWidth" />
                                <Binding Path="SelectedPhoto.OriginalHeight" />
                                <Binding Path="SelectedSize" />
                                <Binding Path="SelectedMode" />
                                <Binding Path="SelectedPhoto.Orientation" />
                            </MultiBinding>
                        </Grid.Height>

                        <!-- 层级 1：纯白相纸底板（在留白模式下显露真实的相纸纯白边，带立体物理阴影） -->
                        <Border
                            Background="#FFFFFF"
                            BorderBrush="#444444"
                            BorderThickness="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PsPaperSizeConverter}" ConverterParameter="Width">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                    <Binding Path="SelectedPhoto.Orientation" />
                                </MultiBinding>
                            </Border.Width>
                            <Border.Height>
                                <MultiBinding Converter="{StaticResource PsPaperSizeConverter}" ConverterParameter="Height">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                    <Binding Path="SelectedPhoto.Orientation" />
                                </MultiBinding>
                            </Border.Height>
                            <Border.Margin>
                                <MultiBinding Converter="{StaticResource PsPaperMarginConverter}">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                    <Binding Path="SelectedPhoto.Orientation" />
                                </MultiBinding>
                            </Border.Margin>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="Black" Opacity="0.55" />
                            </Border.Effect>
                        </Border>

                        <!-- 层级 2：照片原图呈现（Fit 模式居中在纯白相纸上，Fill 模式铺满画板） -->
                        <Image
                            Source="{Binding HighResPreview}"
                            Stretch="Fill"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                            <Image.Width>
                                <MultiBinding Converter="{StaticResource PsImgSizeConverter}" ConverterParameter="Width">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                    <Binding Path="SelectedPhoto.Orientation" />
                                </MultiBinding>
                            </Image.Width>
                            <Image.Height>
                                <MultiBinding Converter="{StaticResource PsImgSizeConverter}" ConverterParameter="Height">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                    <Binding Path="SelectedPhoto.Orientation" />
                                </MultiBinding>
                            </Image.Height>
                            <Image.Margin>
                                <MultiBinding Converter="{StaticResource PsImgMarginConverter}">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                    <Binding Path="SelectedPhoto.Orientation" />
                                </MultiBinding>
                            </Image.Margin>
                        </Image>

                        <!-- 层级 3：照片外围精细描边（确保浅色照片边缘与纯白相纸白边清晰可辨） -->
                        <Border
                            BorderBrush="#35000000"
                            BorderThickness="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PsImgSizeConverter}" ConverterParameter="Width">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                    <Binding Path="SelectedPhoto.Orientation" />
                                </MultiBinding>
                            </Border.Width>
                            <Border.Height>
                                <MultiBinding Converter="{StaticResource PsImgSizeConverter}" ConverterParameter="Height">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                    <Binding Path="SelectedPhoto.Orientation" />
                                </MultiBinding>
                            </Border.Height>
                            <Border.Margin>
                                <MultiBinding Converter="{StaticResource PsImgMarginConverter}">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                    <Binding Path="SelectedPhoto.Orientation" />
                                </MultiBinding>
                            </Border.Margin>
                        </Border>

                        <!-- 层级 4：Fill 模式下相纸外部暗色遮罩（Fit 模式下为空，绝不遮挡纯白留白） -->
                        <Path Fill="#99000000" IsHitTestVisible="False">
                            <Path.Data>
                                <MultiBinding Converter="{StaticResource PsCropMaskConverter}">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                    <Binding Path="SelectedPhoto.Orientation" />
                                    <Binding Path="SelectedPhoto.CropScale" />
                                </MultiBinding>
                            </Path.Data>
                        </Path>

                        <!-- 层级 5：Photoshop 裁切取景框（高反差边框 + 九宫格三分线 + 四角直角手柄 + 边框拖拽热区） -->
                        <Grid
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                            <Grid.Width>
                                <MultiBinding Converter="{StaticResource PsPaperSizeConverter}" ConverterParameter="Width">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                    <Binding Path="SelectedPhoto.Orientation" />
                                    <Binding Path="SelectedPhoto.CropScale" />
                                </MultiBinding>
                            </Grid.Width>
                            <Grid.Height>
                                <MultiBinding Converter="{StaticResource PsPaperSizeConverter}" ConverterParameter="Height">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                    <Binding Path="SelectedPhoto.Orientation" />
                                    <Binding Path="SelectedPhoto.CropScale" />
                                </MultiBinding>
                            </Grid.Height>
                            <Grid.Margin>
                                <MultiBinding Converter="{StaticResource PsPaperMarginConverter}">
                                    <Binding Path="ActualWidth" ElementName="MainViewportHost" />
                                    <Binding Path="ActualHeight" ElementName="MainViewportHost" />
                                    <Binding Path="SelectedPhoto.OriginalWidth" />
                                    <Binding Path="SelectedPhoto.OriginalHeight" />
                                    <Binding Path="SelectedPhoto.OffsetX" />
                                    <Binding Path="SelectedPhoto.OffsetY" />
                                    <Binding Path="SelectedSize" />
                                    <Binding Path="SelectedMode" />
                                    <Binding Path="SelectedPhoto.Orientation" />
                                    <Binding Path="SelectedPhoto.CropScale" />
                                </MultiBinding>
                            </Grid.Margin>

                            <!-- 内部取景区域（按住平移整个裁切框） -->
                            <Border
                                Tag="All"
                                Background="#01000000"
                                Cursor="SizeAll"
                                MouseDown="CropHandle_MouseDown"
                                MouseMove="CropHandle_MouseMove"
                                MouseUp="CropHandle_MouseUp" />

                            <!-- 外框双层高反差细实线（外黑内白，在任何深浅背景上都极度清晰，穿透鼠标） -->
                            <Border BorderBrush="#80000000" BorderThickness="2" Margin="-1" IsHitTestVisible="False" />
                            <Border BorderBrush="#F0FFFFFF" BorderThickness="1" IsHitTestVisible="False" />

                            <!-- 九宫格三等分线 (Rule of Thirds，穿透鼠标) -->
                            <Grid IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 纵向两条三等分线 -->
                                <Border Grid.Column="0" BorderBrush="#50FFFFFF" BorderThickness="0,0,1,0" />
                                <Border Grid.Column="1" BorderBrush="#50FFFFFF" BorderThickness="0,0,1,0" />

                                <!-- 横向两条三等分线 -->
                                <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="#50FFFFFF" BorderThickness="0,0,0,1" />
                                <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#50FFFFFF" BorderThickness="0,0,0,1" />
                            </Grid>

                            <!-- 边框交互拖拽热区（四条边：宽 14px，鼠标放上去呈现双向调节光标） -->
                            <!-- 顶边框热区 -->
                            <Border
                                Tag="Top"
                                Height="14"
                                VerticalAlignment="Top"
                                Margin="16,-7,16,0"
                                Background="Transparent"
                                Cursor="SizeNS"
                                MouseDown="CropHandle_MouseDown"
                                MouseMove="CropHandle_MouseMove"
                                MouseUp="CropHandle_MouseUp" />
                            <!-- 底边框热区 -->
                            <Border
                                Tag="Bottom"
                                Height="14"
                                VerticalAlignment="Bottom"
                                Margin="16,0,16,-7"
                                Background="Transparent"
                                Cursor="SizeNS"
                                MouseDown="CropHandle_MouseDown"
                                MouseMove="CropHandle_MouseMove"
                                MouseUp="CropHandle_MouseUp" />
                            <!-- 左边框热区 -->
                            <Border
                                Tag="Left"
                                Width="14"
                                HorizontalAlignment="Left"
                                Margin="-7,16,0,16"
                                Background="Transparent"
                                Cursor="SizeWE"
                                MouseDown="CropHandle_MouseDown"
                                MouseMove="CropHandle_MouseMove"
                                MouseUp="CropHandle_MouseUp" />
                            <!-- 右边框热区 -->
                            <Border
                                Tag="Right"
                                Width="14"
                                HorizontalAlignment="Right"
                                Margin="0,16,-7,16"
                                Background="Transparent"
                                Cursor="SizeWE"
                                MouseDown="CropHandle_MouseDown"
                                MouseMove="CropHandle_MouseMove"
                                MouseUp="CropHandle_MouseUp" />

                            <!-- PS 风格四角折角视觉与拖拽手柄 -->
                            <!-- 左上角手柄 -->
                            <Grid
                                Tag="TopLeft"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="-6,-6,0,0"
                                Width="32"
                                Height="32"
                                Cursor="SizeNWSE"
                                Background="#01000000"
                                MouseDown="CropHandle_MouseDown"
                                MouseMove="CropHandle_MouseMove"
                                MouseUp="CropHandle_MouseUp">
                                <Path Data="M 4,20 L 4,4 L 20,4" Stroke="White" StrokeThickness="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0" IsHitTestVisible="False" />
                            </Grid>
                            <!-- 右上角手柄 -->
                            <Grid
                                Tag="TopRight"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-6,-6,0"
                                Width="32"
                                Height="32"
                                Cursor="SizeNESW"
                                Background="#01000000"
                                MouseDown="CropHandle_MouseDown"
                                MouseMove="CropHandle_MouseMove"
                                MouseUp="CropHandle_MouseUp">
                                <Path Data="M 12,4 L 28,4 L 28,20" Stroke="White" StrokeThickness="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" IsHitTestVisible="False" />
                            </Grid>
                            <!-- 左下角手柄 -->
                            <Grid
                                Tag="BottomLeft"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="-6,0,0,-6"
                                Width="32"
                                Height="32"
                                Cursor="SizeNESW"
                                Background="#01000000"
                                MouseDown="CropHandle_MouseDown"
                                MouseMove="CropHandle_MouseMove"
                                MouseUp="CropHandle_MouseUp">
                                <Path Data="M 4,12 L 4,28 L 20,28" Stroke="White" StrokeThickness="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,2" IsHitTestVisible="False" />
                            </Grid>
                            <!-- 右下角手柄 -->
                            <Grid
                                Tag="BottomRight"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,-6,-6"
                                Width="32"
                                Height="32"
                                Cursor="SizeNWSE"
                                Background="#01000000"
                                MouseDown="CropHandle_MouseDown"
                                MouseMove="CropHandle_MouseMove"
                                MouseUp="CropHandle_MouseUp">
                                <Path Data="M 12,28 L 28,28 L 28,12" Stroke="White" StrokeThickness="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" IsHitTestVisible="False" />
                            </Grid>

                            <!-- PS 风格四边中心手柄 (可直接按住拖拽调节单方向裁切) -->
                            <Grid
                                Tag="Top"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,-5,0,0"
                                Width="28"
                                Height="14"
                                Cursor="SizeNS"
                                Background="Transparent"
                                MouseDown="CropHandle_MouseDown"
                                MouseMove="CropHandle_MouseMove"
                                MouseUp="CropHandle_MouseUp">
                                <Rectangle Width="16" Height="3" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <Grid
                                Tag="Bottom"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,-5"
                                Width="28"
                                Height="14"
                                Cursor="SizeNS"
                                Background="Transparent"
                                MouseDown="CropHandle_MouseDown"
                                MouseMove="CropHandle_MouseMove"
                                MouseUp="CropHandle_MouseUp">
                                <Rectangle Width="16" Height="3" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <Grid
                                Tag="Left"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="-5,0,0,0"
                                Width="14"
                                Height="28"
                                Cursor="SizeWE"
                                Background="Transparent"
                                MouseDown="CropHandle_MouseDown"
                                MouseMove="CropHandle_MouseMove"
                                MouseUp="CropHandle_MouseUp">
                                <Rectangle Width="3" Height="16" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <Grid
                                Tag="Right"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,-5,0"
                                Width="14"
                                Height="28"
                                Cursor="SizeWE"
                                Background="Transparent"
                                MouseDown="CropHandle_MouseDown"
                                MouseMove="CropHandle_MouseMove"
                                MouseUp="CropHandle_MouseUp">
                                <Rectangle Width="3" Height="16" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Grid>

                </Grid>
            </Border>

            <!-- Row 1: 上下可拖拽分割条 -->
            <GridSplitter
                Grid.Row="1"
                Height="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="#252526"
                ShowsPreview="False"
                Cursor="SizeNS" />

            <!-- Row 2: 资源管理器平铺视图 (控制工具栏 + 多行垂直上下滚动) -->
            <Border
                x:Name="BatchGalleryHost"
                Grid.Row="2"
                Background="#141414"
                BorderBrush="#2D2D2D"
                BorderThickness="0,1,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 平铺视图控制工具栏 -->
                    <Border
                        Grid.Row="0"
                        Background="#1D1D1D"
                        BorderBrush="#282828"
                        BorderThickness="0,0,0,1"
                        Padding="12,0">
                        <Grid Height="34">
                            <!-- 左侧：免修照片过滤单选组 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="免修:" Foreground="#666666" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <RadioButton
                                    GroupName="MatchedFilterGroup"
                                    IsChecked="{Binding ShowAllPhotos}"
                                    VerticalAlignment="Center"
                                    Foreground="#CCCCCC"
                                    FontSize="11"
                                    Margin="0,0,12,0"
                                    Content="全部显示" />
                                <RadioButton
                                    GroupName="MatchedFilterGroup"
                                    IsChecked="{Binding DimMatchedPhotos}"
                                    VerticalAlignment="Center"
                                    Foreground="#CCCCCC"
                                    FontSize="11"
                                    Margin="0,0,12,0"
                                    Content="淡化" />
                                <RadioButton
                                    GroupName="MatchedFilterGroup"
                                    IsChecked="{Binding HideMatchedPhotos}"
                                    VerticalAlignment="Center"
                                    Foreground="#CCCCCC"
                                    FontSize="11"
                                    Content="隐藏" />
                            </StackPanel>

                            <!-- 右侧：缩放滑块 + 统计 + 进度条 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- 导入进度条（仅加载时可见） -->
                                <StackPanel
                                    Orientation="Horizontal"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,12,0">
                                    <TextBlock Text="载入: " Foreground="#888888" FontSize="11" VerticalAlignment="Center" />
                                    <ProgressBar
                                        Width="80"
                                        Height="4"
                                        Background="#2B2B2B"
                                        Foreground="#0078D4"
                                        BorderThickness="0"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding LoadingProgress}"
                                        VerticalAlignment="Center"
                                        Margin="4,0,6,0" />
                                    <TextBlock
                                        Width="100"
                                        Text="{Binding LoadingStatusText}"
                                        Foreground="#888888"
                                        FontSize="11"
                                        TextTrimming="CharacterEllipsis"
                                        TextAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="缩放:" Foreground="#666666" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Slider
                                    Width="75"
                                    Minimum="80"
                                    Maximum="300"
                                    Value="{Binding GalleryCardWidth}"
                                    VerticalAlignment="Center"
                                    Focusable="False"
                                    Margin="0,0,14,0" />
                                <TextBlock Text="{Binding Photos.Count, StringFormat='共 {0} 张'}" Foreground="#555555" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text=" · " Foreground="#3A3A3A" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding NeedAdjustCount, StringFormat='{}{0} 张需调整'}" Foreground="#B0B0B0" FontWeight="Medium" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ListBox
                        x:Name="BatchGalleryList"
                        Grid.Row="1"
                        ItemsSource="{Binding Photos}"
                        SelectedItem="{Binding SelectedPhoto}"
                        SelectionMode="Extended"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="12,10"
                        IsTextSearchEnabled="False"
                        KeyboardNavigation.DirectionalNavigation="None"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.CanContentScroll="False"
                        PreviewMouseDown="BatchGalleryList_PreviewMouseDown"
                        PreviewMouseWheel="BatchGalleryList_PreviewMouseWheel">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="4" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Visibility">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource HideMatchedVisibilityConverter}">
                                            <Binding Path="IsAspectMatched" />
                                            <Binding Path="DataContext.HideMatchedPhotos" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 资源管理器风格平铺照片卡片 (紧凑饱满自适应) -->
                                <Border
                                    Width="{Binding DataContext.GalleryCardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Height="{Binding DataContext.GalleryCardHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Background="#1E1E1E"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    Cursor="Hand"
                                    PreviewMouseRightButtonDown="PhotoCard_PreviewMouseRightButtonDown">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{StaticResource HideMatchedVisibilityConverter}">
                                            <Binding Path="IsAspectMatched" />
                                            <Binding Path="DataContext.HideMatchedPhotos" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        </MultiBinding>
                                    </Border.Visibility>
                                    <Border.Opacity>
                                        <MultiBinding Converter="{StaticResource DimMatchedOpacityConverter}">
                                            <Binding Path="IsAspectMatched" />
                                            <Binding Path="DataContext.DimMatchedPhotos" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        </MultiBinding>
                                    </Border.Opacity>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Header="裁剪填充"
                                                InputGestureText="Fill"
                                                Command="{Binding DataContext.SetModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="Fill"
                                                IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fill}" />
                                            <MenuItem
                                                Header="留白完整"
                                                InputGestureText="Fit"
                                                Command="{Binding DataContext.SetModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="Fit"
                                                IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fit}" />
                                            <Separator />
                                            <MenuItem
                                                Header="切换相纸方向"
                                                InputGestureText="X"
                                                Command="{Binding DataContext.ToggleOrientationCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Separator />
                                            <MenuItem
                                                Header="在资源管理器中显示"
                                                Command="{Binding DataContext.OpenFileInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                            <MenuItem
                                                Header="复制文件完整路径"
                                                Command="{Binding DataContext.CopyFilePathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#2F2F2F" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#555555" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#0078D4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{Binding DataContext.GalleryImageContainerHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 照片视口展示区 (自然居中) -->
                                        <Border
                                            Grid.Row="0"
                                            Background="Transparent"
                                            CornerRadius="3,3,0,0"
                                            ClipToBounds="True">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid.Width>
                                                    <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="ContainerWidth">
                                                        <Binding Path="OriginalWidth" />
                                                        <Binding Path="OriginalHeight" />
                                                        <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="Mode" />
                                                        <Binding Path="OffsetX" />
                                                        <Binding Path="OffsetY" />
                                                        <Binding Path="Orientation" />
                                                        <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="CropScale" />
                                                    </MultiBinding>
                                                </Grid.Width>
                                                <Grid.Height>
                                                    <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="ContainerHeight">
                                                        <Binding Path="OriginalWidth" />
                                                        <Binding Path="OriginalHeight" />
                                                        <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="Mode" />
                                                        <Binding Path="OffsetX" />
                                                        <Binding Path="OffsetY" />
                                                        <Binding Path="Orientation" />
                                                        <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="CropScale" />
                                                    </MultiBinding>
                                                </Grid.Height>

                                                <!-- Fit 模式纯白相纸底板 -->
                                                <Border
                                                    Background="#FFFFFF"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top">
                                                    <Border.Visibility>
                                                        <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="FitPaperVisibility">
                                                            <Binding Path="OriginalWidth" />
                                                            <Binding Path="OriginalHeight" />
                                                            <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="Mode" />
                                                            <Binding Path="OffsetX" />
                                                            <Binding Path="OffsetY" />
                                                            <Binding Path="Orientation" />
                                                            <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="CropScale" />
                                                        </MultiBinding>
                                                    </Border.Visibility>
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="CropWidth">
                                                            <Binding Path="OriginalWidth" />
                                                            <Binding Path="OriginalHeight" />
                                                            <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="Mode" />
                                                            <Binding Path="OffsetX" />
                                                            <Binding Path="OffsetY" />
                                                            <Binding Path="Orientation" />
                                                            <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="CropScale" />
                                                        </MultiBinding>
                                                    </Border.Width>
                                                    <Border.Height>
                                                        <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="CropHeight">
                                                            <Binding Path="OriginalWidth" />
                                                            <Binding Path="OriginalHeight" />
                                                            <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="Mode" />
                                                            <Binding Path="OffsetX" />
                                                            <Binding Path="OffsetY" />
                                                            <Binding Path="Orientation" />
                                                            <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="CropScale" />
                                                        </MultiBinding>
                                                    </Border.Height>
                                                    <Border.Margin>
                                                        <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="CropMargin">
                                                            <Binding Path="OriginalWidth" />
                                                            <Binding Path="OriginalHeight" />
                                                            <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="Mode" />
                                                            <Binding Path="OffsetX" />
                                                            <Binding Path="OffsetY" />
                                                            <Binding Path="Orientation" />
                                                            <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="CropScale" />
                                                        </MultiBinding>
                                                    </Border.Margin>
                                                </Border>

                                                <!-- 完整照片原图呈现 -->
                                                <Image
                                                    Source="{Binding Thumbnail}"
                                                    Stretch="Fill"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    RenderOptions.BitmapScalingMode="LowQuality">
                                                    <Image.Width>
                                                        <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="ImageWidth">
                                                            <Binding Path="OriginalWidth" />
                                                            <Binding Path="OriginalHeight" />
                                                            <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="Mode" />
                                                            <Binding Path="OffsetX" />
                                                            <Binding Path="OffsetY" />
                                                            <Binding Path="Orientation" />
                                                            <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="CropScale" />
                                                        </MultiBinding>
                                                    </Image.Width>
                                                    <Image.Height>
                                                        <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="ImageHeight">
                                                            <Binding Path="OriginalWidth" />
                                                            <Binding Path="OriginalHeight" />
                                                            <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="Mode" />
                                                            <Binding Path="OffsetX" />
                                                            <Binding Path="OffsetY" />
                                                            <Binding Path="Orientation" />
                                                            <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="CropScale" />
                                                        </MultiBinding>
                                                    </Image.Height>
                                                    <Image.Margin>
                                                        <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="ImageMargin">
                                                            <Binding Path="OriginalWidth" />
                                                            <Binding Path="OriginalHeight" />
                                                            <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="Mode" />
                                                            <Binding Path="OffsetX" />
                                                            <Binding Path="OffsetY" />
                                                            <Binding Path="Orientation" />
                                                            <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="CropScale" />
                                                        </MultiBinding>
                                                    </Image.Margin>
                                                </Image>

                                                <!-- Fill 模式下：被裁切掉的外围区域暗色半透明遮罩 (清楚可见被裁切掉的内容) -->
                                                <Path
                                                    Fill="#A0000000"
                                                    IsHitTestVisible="False">
                                                    <Path.Data>
                                                        <MultiBinding Converter="{StaticResource BatchCardCropConverter}" ConverterParameter="MaskGeometry">
                                                            <Binding Path="OriginalWidth" />
                                                            <Binding Path="OriginalHeight" />
                                                            <Binding Path="DataContext.SelectedSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="Mode" />
                                                            <Binding Path="OffsetX" />
                                                            <Binding Path="OffsetY" />
                                                            <Binding Path="Orientation" />
                                                            <Binding Path="DataContext.GalleryCardBoxWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="DataContext.GalleryCardBoxHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            <Binding Path="CropScale" />
                                                        </MultiBinding>
                                                    </Path.Data>
                                                </Path>

                                                <!-- 留白模式状态微标签 -->
                                                <Border
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="6"
                                                    Background="#CC1F1F1F"
                                                    BorderBrush="#44FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="0"
                                                    Padding="4,1"
                                                    IsHitTestVisible="False">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Mode}" Value="Fit">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="留白" FontSize="9" Foreground="#CCCCCC" FontWeight="Medium" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- 卡片底部元数据 (文件名与尺寸完整展示) -->
                                        <Grid Grid.Row="1" Margin="6,2,6,2" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- 第一行：完整/紧凑文件名 -->
                                            <TextBlock
                                                Grid.Row="0"
                                                Text="{Binding FileName}"
                                                Foreground="#D0D0D0"
                                                FontSize="11"
                                                FontWeight="Medium"
                                                TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- 第二行：真实像素分辨率 -->
                                            <TextBlock
                                                Grid.Row="1"
                                                FontSize="9"
                                                Foreground="#606060"
                                                Margin="0,1,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} × {1}">
                                                        <Binding Path="OriginalWidth" />
                                                        <Binding Path="OriginalHeight" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 鼠标中键自动平滑滚动指示器 (严格居中对称，完全对齐) -->
                    <Canvas x:Name="AutoScrollCanvas" IsHitTestVisible="False">
                        <Grid
                            x:Name="AutoScrollAnchor"
                            Width="32"
                            Height="32"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                            <!-- 外层深色半透明圆环 -->
                            <Ellipse Width="32" Height="32" Fill="#E6202020" Stroke="#99FFFFFF" StrokeThickness="1.5" />
                            <!-- 中心圆点 (严格位于 16, 16) -->
                            <Ellipse Width="6" Height="6" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- 上下滚动精准居中对称箭头 (X轴在 16 对称，左右跨度各 5px: 11 与 21) -->
                            <Path
                                Data="M 11,10 L 16,5 L 21,10 M 11,22 L 16,27 L 21,22"
                                Stroke="#FFFFFF"
                                StrokeThickness="1.5"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top" />
                        </Grid>
                    </Canvas>
                </Grid>
            </Border>

        </Grid>

        <!--  右侧属性设置面板  -->
        <Border
            Grid.Column="1"
            Background="#232323"
            BorderBrush="#2D2D2D"
            BorderThickness="0,0,0,0"
            Padding="18">
            <DockPanel LastChildFill="True">
                <!-- 底部批量导出按钮与状态信息 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
                    <!-- 导出与取消按钮容器 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Height="40"
                            Background="#0078D4"
                            Command="{Binding ExportCommand}"
                            Content="批量开始导出"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            FontSize="14"
                            Foreground="White"
                            BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4" />
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button
                            Grid.Column="1"
                            Height="40"
                            Margin="8,0,0,0"
                            Padding="14,0"
                            Background="#D83B01"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="13"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding CancelExportCommand}"
                            Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}"
                            Content="中止">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- 导出进度指示器 -->
                    <ProgressBar
                        Height="4"
                        Margin="0,8,0,0"
                        Background="#333333"
                        Foreground="#0078D4"
                        BorderThickness="0"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding ExportProgress}"
                        Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}" />

                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="#888888"
                        FontSize="11"
                        TextWrapping="Wrap"
                        Text="输出目录: 原图同级 Clipped_Photos" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="#CCCCCC"
                        FontSize="12"
                        FontWeight="Medium"
                        TextWrapping="Wrap"
                        Text="{Binding StatusText}" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#EEEEEE"
                                VerticalAlignment="Center"
                                Text="冲印设置" />
                            <Button
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="#333333"
                                Foreground="#CCCCCC"
                                BorderThickness="0"
                                Padding="8,4"
                                Cursor="Hand"
                                FontSize="11"
                                Click="SelectFolder_Click"
                                Content="+ 导入">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="3" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- 当前照片信息卡片 -->
                        <Border
                            Background="#1E1E1E"
                            BorderBrush="#303030"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPhoto}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#AAAAAA"
                                    Text="当前照片" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Text="{Binding SelectedPhoto.FileName}"
                                    Foreground="#FFFFFF"
                                    FontWeight="Medium"
                                    FontSize="12"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock Text="原图像素: " FontSize="11" Foreground="#666666" />
                                    <TextBlock Text="{Binding SelectedPhoto.OriginalWidth}" FontSize="11" Foreground="#AAAAAA" />
                                    <TextBlock Text=" x " FontSize="11" Foreground="#666666" />
                                    <TextBlock Text="{Binding SelectedPhoto.OriginalHeight}" FontSize="11" Foreground="#AAAAAA" />
                                    <TextBlock Text=" px" FontSize="11" Foreground="#666666" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border
                            Background="#1E1E1E"
                            BorderBrush="#303030"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#AAAAAA"
                                    Text="相纸规格 (300 DPI)" />
                                <ComboBox
                                    Margin="0,8,0,8"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding Sizes}"
                                    SelectedItem="{Binding SelectedSize}"
                                    Height="28" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="输出像素: " FontSize="11" Foreground="#666666" />
                                    <TextBlock Text="{Binding SelectedSize.PixelWidth}" FontSize="11" Foreground="#888888" />
                                    <TextBlock Text="x" FontSize="11" Foreground="#666666" />
                                    <TextBlock Text="{Binding SelectedSize.PixelHeight}" FontSize="11" Foreground="#888888" />
                                    <TextBlock Text=" px" FontSize="11" Foreground="#666666" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border
                            Background="#1E1E1E"
                            BorderBrush="#303030"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#AAAAAA"
                                    Text="裁切排版" />
                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <RadioButton
                                        Style="{StaticResource IndustrialRadio}"
                                        Content="裁剪填充 (Fill)"
                                        IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fill}" />
                                    <RadioButton
                                        Style="{StaticResource IndustrialRadio}"
                                        Content="留白完整 (Fit)"
                                        IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fit}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border
                            Background="#1E1E1E"
                            BorderBrush="#303030"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#AAAAAA"
                                        Text="裁切相纸方向" />
                                    <Button
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="#2B2B2B"
                                        Foreground="#CCCCCC"
                                        BorderThickness="0"
                                        Padding="6,2"
                                        Cursor="Hand"
                                        FontSize="10"
                                        Command="{Binding ToggleOrientationCommand}"
                                        Content="翻转 (X)">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="2" />
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Text="{Binding SelectedPhoto.Orientation, Converter={StaticResource OrientationToDisplayConverter}}"
                                    Foreground="#EEEEEE"
                                    FontWeight="Medium"
                                    FontSize="12" />
                            </StackPanel>
                        </Border>

                        <Border
                            Background="#1A1A1A"
                            BorderBrush="#2C2C2C"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#888888"
                                    Text="操作快捷键" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="20" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="G / 双击" Foreground="#0078D4" FontSize="11" FontWeight="Medium" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="切换批量预览 / 单张精调" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Enter / Esc" Foreground="#CCCCCC" FontSize="11" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="打开单张精调 / 返回网格" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Q / E" Foreground="#CCCCCC" FontSize="11" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="切换上一张 / 下一张照片" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="F 键" Foreground="#CCCCCC" FontSize="11" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="切换裁剪填充 / 留白模式 (Fill/Fit)" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="X 键" Foreground="#CCCCCC" FontSize="11" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="翻转相纸裁切方向 (横向 / 纵向)" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="WASD / 方向键" Foreground="#CCCCCC" FontSize="11" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="构图微调 (Shift加速 Ctrl贴边)" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!--  全屏导入引导层 (当未导入照片时呈现)  -->
        <Grid
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="#181818">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDropOverlayVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid
                MaxWidth="880"
                MaxHeight="560"
                Margin="32">
                <Rectangle
                    Stroke="#2E2E2E"
                    StrokeThickness="1.5"
                    StrokeDashArray="6 6"
                    RadiusX="8"
                    RadiusY="8"
                    IsHitTestVisible="False" />

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Border
                        Width="88"
                        Height="88"
                        Margin="0,0,0,24"
                        Background="#252526"
                        BorderBrush="#383838"
                        BorderThickness="1"
                        CornerRadius="44"
                        HorizontalAlignment="Center">
                        <Path
                            Width="32"
                            Height="32"
                            Data="M 0,16 L 32,16 M 16,0 L 16,32"
                            Stroke="#0078D4"
                            StrokeThickness="3"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <TextBlock
                        Text="拖拽照片或文件夹至此"
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,28" />

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,24">
                        <Button
                            Width="160"
                            Height="42"
                            Margin="0,0,16,0"
                            Background="#0078D4"
                            Foreground="#FFFFFF"
                            FontSize="14"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="SelectFolder_Click"
                            Content="导入照片文件夹">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button
                            Width="160"
                            Height="42"
                            Background="#2A2A2A"
                            Foreground="#CCCCCC"
                            FontSize="14"
                            FontWeight="SemiBold"
                            BorderBrush="#444444"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="SelectFiles_Click"
                            Content="添加照片文件">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                        <Border Background="#252526" BorderBrush="#353535" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="4,0">
                            <TextBlock Text="JPG / JPEG" FontSize="11" Foreground="#AAAAAA" />
                        </Border>
                        <Border Background="#252526" BorderBrush="#353535" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="4,0">
                            <TextBlock Text="PNG" FontSize="11" Foreground="#AAAAAA" />
                        </Border>
                        <Border Background="#252526" BorderBrush="#353535" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="4,0">
                            <TextBlock Text="HEIC" FontSize="11" Foreground="#AAAAAA" />
                        </Border>
                        <Border Background="#252526" BorderBrush="#353535" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="4,0">
                            <TextBlock Text="ZIP (Live Photo)" FontSize="11" Foreground="#AAAAAA" />
                        </Border>
                        <Border Background="#252526" BorderBrush="#353535" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="4,0">
                            <TextBlock Text="WEBP" FontSize="11" Foreground="#AAAAAA" />
                        </Border>
                        <Border Background="#252526" BorderBrush="#353535" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="4,0">
                            <TextBlock Text="TIFF / BMP" FontSize="11" Foreground="#AAAAAA" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!--  全局最高层级载入进度遮罩 (只要处于导入或加载状态，任何场景均在屏幕正中央高对比度呈现)  -->
        <Grid
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="#A0000000"
            Panel.ZIndex="999"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border
                Width="460"
                Background="#202020"
                BorderBrush="#3E3E3E"
                BorderThickness="1"
                CornerRadius="8"
                Padding="32,28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="396" Margin="0,0,0,16">
                        <TextBlock
                            Text="正在载入照片"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{Binding LoadingProgress, StringFormat='{}{0:F0}%'}"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#0078D4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>

                    <ProgressBar
                        Width="396"
                        Height="8"
                        Background="#2B2B2B"
                        Foreground="#0078D4"
                        BorderThickness="0"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding LoadingProgress}" />

                    <TextBlock
                        Margin="0,14,0,0"
                        Text="{Binding LoadingStatusText}"
                        FontSize="12"
                        Foreground="#AAAAAA"
                        HorizontalAlignment="Center"
                        MaxWidth="396"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
